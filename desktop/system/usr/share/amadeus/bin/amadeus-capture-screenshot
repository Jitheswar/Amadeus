#!/bin/bash

# amadeus:summary=Take a screenshot
# amadeus:group=capture
# amadeus:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# amadeus:examples=amadeus screenshot | amadeus capture screenshot region
# amadeus:aliases=amadeus screenshot

if [[ -n ${AMADEUS_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$AMADEUS_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   amadeus-i18n capture.screenshotSaved, amadeus-i18n capture.screenshotSavedCopied,
#   amadeus-i18n capture.screenshotOpen, amadeus-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
