#!/bin/bash

# amadeus:summary=Reinstall all default Amadeus packages from the stable channel, or on Apple Silicon the edge channel
# amadeus:requires-sudo=true

set -e

# Reinstall all default Amadeus packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$AMADEUS_PATH/install/helpers/pacman.sh"
platform=$(amadeus-hw-platform)
channel=$(amadeus_pacman_default_channel "$platform")
amadeus-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
amadeus-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(amadeus-pkg-defaults)
mapfile -t packages <<<"$default_packages"
# --ask 4 accepts removing a stock package a default replaces, such as
# power-profiles-daemon for omarchy-power-profiles-daemon.
amadeus-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
