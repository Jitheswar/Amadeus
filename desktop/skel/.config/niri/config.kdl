// Your desktop configuration. System defaults load first; anything below overrides them.
// It is checked before it is applied: a mistake here leaves the running desktop as it was.
// Reference: https://github.com/YaLTeR/niri/wiki
include "/usr/share/amadeus-os/niri/default.kdl"

// Examples:
// input { keyboard { xkb { layout "us,in"; }; }; }
