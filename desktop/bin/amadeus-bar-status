#!/bin/bash
# One JSON line of slow-changing status for the bar. Reads sysfs and local sockets only.
bat="" state=""
for b in /sys/class/power_supply/BAT*; do
  [[ -r $b/capacity ]] && bat=$(<"$b/capacity") && state=$(<"$b/status") && break
done
net=$(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null | awk -F: '$2=="connected" && $1!="loopback"{print $1":"$3; exit}')
vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{v=int($2*100+0.5); print ($3=="[MUTED]") ? "muted" : v}')
gpu=""
for d in /sys/bus/pci/devices/*; do
  [[ $(<"$d/vendor") == 0x10de && $(<"$d/class") == 0x03* ]] && gpu=$(<"$d/power/runtime_status") && break
done
printf '{"battery":"%s","charging":%s,"net":"%s","volume":"%s","gpu":"%s"}\n' \
  "$bat" "$([[ $state == Charging || $state == Full ]] && echo true || echo false)" "${net//\"/}" "$vol" "$gpu"
