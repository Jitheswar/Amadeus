#!/bin/bash

# amadeus:summary=Show a fuzzy-finder TUI for picking new AUR packages to install.
# amadeus:requires-sudo=true

fzf_args=(
  --multi
  --preview 'amadeus-aur info {1}'
  --preview-label='alt-p: toggle description, alt-b/B: recipe or description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --bind 'alt-b:change-preview:amadeus-aur recipe {1}'
  --bind 'alt-B:change-preview:amadeus-aur info {1}'
  --color 'pointer:green,marker:green'
)

pkg_names=$(amadeus-aur list | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  # amadeus-aur shows each recipe and asks before building it.
  mapfile -t picked <<<"$pkg_names"
  amadeus-aur install "${picked[@]}"
  code=$?
  sudo updatedb --prune-bind-mounts=no --add-prunepaths=/.snapshots
  amadeus-show-done $code
fi
