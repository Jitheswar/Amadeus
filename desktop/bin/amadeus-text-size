#!/usr/bin/python3
# Set one text size for the Amadeus shell, panel, GTK applications and terminal configuration.
"""amadeus-text-size [9..20|reset]

One knob, adapted from Omarchy: a live shell font size, a quantized GTK scale,
and terminal point sizes. Existing terminals may need a new window.
Legacy percentage arguments are converted around the 14px default.
"""
import json, os, re, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
THEME = ROOT / "amadeus/theme.json"
DEFAULT = 14


def run(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=10, check=True)


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
        if path.exists():
            shutil.copymode(path, name)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def main():
    try:
        theme = json.loads(THEME.read_text()) if THEME.exists() else {}
        if not isinstance(theme, dict):
            raise ValueError("the theme must be a JSON object")
        if len(sys.argv) == 1:
            print(f"{theme.get('font_size', DEFAULT)} px")
            return
        value = sys.argv[1]
        if value == "reset":
            size = DEFAULT
        elif re.fullmatch(r"[0-9]+%", value):
            size = round(DEFAULT * int(value[:-1]) / 100)
        elif re.fullmatch(r"[0-9]+", value):
            size = int(value)
        else:
            raise ValueError("use a whole text size from 9 to 20 px, or reset")
        if not 9 <= size <= 20:
            raise ValueError("text size must be from 9 to 20 px")
        old_factor = run(["gsettings", "get", "org.gnome.desktop.interface", "text-scaling-factor"]).stdout.strip()
        font = run(["gsettings", "get", "org.gnome.desktop.interface", "font-name"]).stdout.strip("'\n")
        match = re.search(r"([0-9.]+)$", font)
        points = float(match[1]) if match else 11
        factor = int(points * size / DEFAULT + 0.5) / points
        changes = {THEME: json.dumps(dict(theme, font_size=size), indent=2) + "\n"}
        term_points = int(11 * size / DEFAULT + 0.5)
        for rel, pattern, replacement in (
            ("foot/foot.ini", r"(:size=)[0-9.]+", rf"\g<1>{term_points}"),
            ("alacritty/alacritty.toml", r"(?m)^size\s*=.*", f"size = {term_points}"),
            ("kitty/kitty.conf", r"(?m)^font_size\s+.*", f"font_size {term_points}"),
            ("ghostty/config", r"(?m)^font-size\s*=.*", f"font-size = {term_points}")):
            path = ROOT / rel
            if path.is_file():
                changes[path] = re.sub(pattern, replacement, path.read_text())
        before = {path: path.read_bytes() if path.exists() else None for path in changes}
        try:
            run(["gsettings", "set", "org.gnome.desktop.interface", "text-scaling-factor", f"{factor:.4f}"])
            for path, text in changes.items():
                write(path, text)
            foot = ROOT / "foot/foot.ini"
            if foot in changes and shutil.which("foot"):
                run(["foot", "--check-config", "--config", str(foot)])
        except Exception:
            for path, old in before.items():
                if old is None:
                    path.unlink(missing_ok=True)
                else:
                    write(path, old.decode())
            run(["gsettings", "set", "org.gnome.desktop.interface", "text-scaling-factor", old_factor])
            raise
        print(f"Text size: {size} px (shell, GTK and terminals)")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"Text size was not changed: {error}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
