#!/bin/bash

# amadeus:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# amadeus:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
amadeus-pkg-add heroic-games-launcher-bin
amadeus-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
