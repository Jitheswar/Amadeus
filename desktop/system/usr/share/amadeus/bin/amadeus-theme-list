#!/bin/bash

# amadeus:summary=List available themes
# amadeus:examples=amadeus theme list | amadeus theme set "Tokyo Night"

{
  find ~/.config/amadeus/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$AMADEUS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
