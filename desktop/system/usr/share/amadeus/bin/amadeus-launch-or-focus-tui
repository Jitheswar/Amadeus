#!/bin/bash

# amadeus:summary=Launch a TUI or focus an existing terminal window for it
# amadeus:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.amadeus.$(basename "$1")"
fi

LAUNCH_COMMAND="amadeus-launch-tui $@"

exec amadeus-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
