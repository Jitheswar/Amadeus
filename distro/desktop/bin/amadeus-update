#!/bin/bash
# Update the whole system: Arch packages first (snapshotted before and after), then the
# applications that come from AUR recipes. Run as your user, not as root.
set -euo pipefail
(( EUID != 0 )) || { echo "Run amadeus-update as your user; it asks for the password when needed."; exit 1; }
sudo pacman -Syu
work=${XDG_CACHE_HOME:-$HOME/.cache}/amadeus-update; mkdir -p "$work"
mapfile -t foreign < <(pacman -Qmq | grep -vxE 'amadeus|amadeus-desktop' || true)
(( ${#foreign[@]} )) || exit 0
args=$(printf '&arg[]=%s' "${foreign[@]}")
latest=$(curl -fsS "https://aur.archlinux.org/rpc/v5/info?${args#&}" | python3 -c 'import json,sys
for r in json.load(sys.stdin)["results"]: print(r["Name"], r["Version"])') || { echo "Could not reach the AUR; applications from it were not checked."; exit 0; }
while read -r name ver; do
  [[ $(vercmp "$ver" "$(pacman -Q "$name" | cut -d" " -f2)") -gt 0 ]] || continue
  echo "==> Updating $name to $ver"
  rm -rf "$work/$name"; git clone -q --depth 1 "https://aur.archlinux.org/$name.git" "$work/$name"
  (cd "$work/$name" && makepkg -sif --noconfirm --needed) || echo "    $name could not be updated; the installed version is unchanged."
done <<<"$latest"
