#!/bin/bash

# amadeus:summary=Remove Steam and all of its game libraries, configs, and caches.
# amadeus:requires-sudo=true

set -e

amadeus-lifecycle-dispatch pre-remove steam
amadeus-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
