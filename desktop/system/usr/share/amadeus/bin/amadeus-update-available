#!/bin/bash

# amadeus:summary=Check whether Amadeus updates are available.

set -euo pipefail

updates=()

if [[ $AMADEUS_PATH != "/usr/share/amadeus" ]]; then
  upstream=$(git -C "$AMADEUS_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$AMADEUS_PATH" fetch --quiet 2>/dev/null || true

    behind=$(git -C "$AMADEUS_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("amadeus-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi

# Amadeus is two packages, the desktop (amadeus-desktop) and the assistant (amadeus); a new
# version of either is an Amadeus update. Other packages are left to the update itself.
packages=()
for package in amadeus-desktop amadeus; do
  pacman -Qq "$package" >/dev/null 2>&1 && packages+=("$package")
done
if (( ${#packages[@]} > 0 )); then
  while read -r update; do
    [[ -n $update ]] && updates+=("$update")
  done < <(checkupdates --nocolor 2>/dev/null | awk -v names=" ${packages[*]} " 'index(names, " " $1 " ")' || true)
fi

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Amadeus is up to date"
  exit 1
fi
