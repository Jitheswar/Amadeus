#!/bin/bash
# Get a stuck part of the desktop working again without restarting the computer.
#   amadeus-restart audio        restart the sound services, forcing them down if they hang
#   amadeus-restart bluetooth    unblock the Bluetooth radio
#   amadeus-restart wifi         unblock Wi-Fi, switch networking on and rescan
#   amadeus-restart trackpad     reset a touchpad that stopped responding (asks for your password)
#   amadeus-restart shell        restart the bar, menus and notifications
#   amadeus-restart desktop      reload the window manager's settings
#   amadeus-restart terminal     make open terminals reread their settings
#   amadeus-restart app NAME...  close a program and start it again
set -euo pipefail

audio() {
  local services=(wireplumber.service pipewire.service pipewire-pulse.service)
  echo "Restarting the sound services..."
  if ! timeout 25s systemctl --user restart "${services[@]}"; then
    echo "They did not restart cleanly; forcing them down."
    systemctl --user kill --kill-whom=all --signal=KILL "${services[@]}" >/dev/null 2>&1 || true
    systemctl --user reset-failed "${services[@]}" >/dev/null 2>&1 || true
    timeout 25s systemctl --user start pipewire.service pipewire-pulse.service wireplumber.service || {
      echo "The sound services did not start. See: systemctl --user status pipewire wireplumber" >&2; return 1; }
  fi
  if timeout 5s wpctl status >/dev/null 2>&1; then echo "Sound is back."; else
    echo "The sound services run but do not answer. A USB audio device may be stuck: unplug it and try again." >&2; return 1; fi
}

trackpad() {
  local driver=/sys/bus/i2c/drivers/i2c_hid_acpi dev input found=0
  for dev in "$driver"/i2c-*; do
    [[ -e $dev ]] || continue
    for input in "$dev"/*/input/input*; do
      grep -qx ID_INPUT_TOUCHPAD=1 <<<"$(udevadm info --query=property "$input" 2>/dev/null)" || continue
      echo "Resetting $(basename "$dev")..."
      basename "$dev" | sudo tee "$driver/unbind" >/dev/null; sleep 1
      basename "$dev" | sudo tee "$driver/bind" >/dev/null
      found=1; break
    done
  done
  if lsmod | grep '^intel_quicki2c' >/dev/null; then
    echo "Reloading the Intel touch controller..."
    sudo modprobe -r intel_quicki2c && sudo modprobe intel_quicki2c && found=1
  fi
  # A touchpad that was never bound (it shows as a PS/2 mouse) comes up when its driver loads again.
  if (( !found )) && lsmod | grep '^i2c_hid_acpi' >/dev/null; then
    echo "Reloading the touchpad driver..."
    sudo modprobe -r i2c_hid_acpi && sudo modprobe i2c_hid_acpi && found=1
  fi
  if (( found )); then echo "Done."; else echo "No I2C touchpad was found to reset."; fi
}

case ${1:-} in
  audio) audio ;;
  bluetooth) rfkill unblock bluetooth && echo "Bluetooth is unblocked." ;;
  wifi)
    rfkill unblock wifi; nmcli networking on; nmcli radio wifi on
    nmcli device wifi rescan 2>/dev/null || true
    echo "Wi-Fi is on and scanning." ;;
  trackpad) trackpad ;;
  shell)
    pkill -x quickshell 2>/dev/null || true; sleep 0.3
    setsid uwsm-app -- quickshell -p /usr/share/amadeus-os/shell >/dev/null 2>&1 &
    echo "The shell is restarting." ;;
  desktop) hyprctl reload >/dev/null && echo "Desktop settings reloaded." ;;
  terminal)
    pkill -USR1 -x kitty 2>/dev/null || true; pkill -USR2 -x ghostty 2>/dev/null || true
    [[ ! -f ${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml ]] || touch "${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
    echo "Open terminals were asked to reread their settings; foot takes them in a new window." ;;
  app)
    [[ -n ${2:-} ]] || { sed -n 10p "$0"; exit 1; }
    shift; pkill -x -- "$1" || true; sleep 0.3
    setsid uwsm-app -- "$@" >/dev/null 2>&1 &
    echo "Restarted $1." ;;
  *) sed -n 2,10p "$0"; exit 1 ;;
esac
