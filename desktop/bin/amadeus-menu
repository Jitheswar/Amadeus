#!/usr/bin/python3
# The Amadeus menu (Super+Space): apps, learning, appearance, triggers, setup, install, remove, update and system.
"""amadeus-menu [ENTRY [CHOICE...]]
  amadeus-menu                    open the menu
  amadeus-menu install            open one entry: its id (setup.default), an alias (defaults) or a label
  amadeus-menu setup Display      and pick within it by label, so a search result can go straight there
  amadeus-menu --menu-index       every entry as id, label, where it is, search words
  amadeus-menu --settings-index   the defaults and config files the menu offers
  amadeus-menu --default-types    which file types each default application kind covers
The entries are in /usr/share/amadeus-os/menu.jsonc. Add, change or hide your own in
~/.config/amadeus/menu.jsonc; each plugin can add its own menu.jsonc."""
import json, os, re, subprocess, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SHIPPED = Path(os.environ.get("AMADEUS_MENU") or ("/usr/share/amadeus-os/menu.jsonc" if Path("/usr/share/amadeus-os/menu.jsonc").exists() else HERE.parent / "menu/menu.jsonc"))
PROVIDERS = os.environ.get("AMADEUS_MENU_PROVIDERS") or ("/usr/lib/amadeus-os/amadeus-menu-providers" if Path("/usr/lib/amadeus-os/amadeus-menu-providers").exists() else str(HERE.parent / "lib/amadeus-menu-providers"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "amadeus"


def jsonc(text):
    """JSON with // comments and trailing commas. Comment markers inside strings are kept."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1]); i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True; out.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))


def load():
    tree = {}
    files = [SHIPPED] + sorted(CONFIG.glob("plugins/*/menu.jsonc")) + [CONFIG / "menu.jsonc"]
    for f in files:
        try:
            entries = jsonc(f.read_text())
        except (OSError, ValueError) as e:
            if f == SHIPPED:
                sys.exit(f"The menu definition {f} could not be read: {e}")
            if f.exists():
                print(f"Skipped {f}: {e}", file=sys.stderr)
            continue
        for key, entry in entries.items():
            tree[key] = {**tree.get(key, {}), **entry}
    return {k: v for k, v in tree.items() if not v.get("hidden")}


TREE = load()


def parent(key):
    return key.rpartition(".")[0]


def holds(cond):
    if not cond:
        return True
    try:
        return subprocess.run(["bash", "-c", cond], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def children(key):
    return [k for k in TREE if parent(k) == key and holds(TREE[k].get("when"))]


def path_of(key):
    names, k = [], parent(key)
    while k:
        names.insert(0, TREE.get(k, {}).get("label", k)); k = parent(k)
    return " › ".join(["Amadeus"] + names)


def find(name, within=None):
    """An entry by id, alias or label; within a submenu, its children come first."""
    low = name.lower()
    pools = ([children(within)] if within is not None else []) + [list(TREE)]
    for pool in pools:
        for k in pool:
            e = TREE[k]
            if low in (k.lower(), e.get("label", "").lower()) or low in [a.lower() for a in e.get("aliases", [])]:
                return k
    return None


def provider(name, args):
    return subprocess.run(["bash", PROVIDERS, name, *args]).returncode


def run(key, rest):
    e = TREE[key] if key else {"label": "Amadeus"}
    if e.get("action"):
        if e.get("terminal"):
            cmd = f"{e['action']}; echo; read -rsn1 -p 'Press any key to close.'"
            os.execvp("amadeus-terminal", ["amadeus-terminal", "--title", f"Amadeus: {e['label']}", "-e", "bash", "-c", cmd])
        os.execvp("bash", ["bash", "-c", e["action"]])
    if e.get("provider"):
        sys.exit(provider(e["provider"], [*e.get("args", []), *rest]))
    if e.get("guard") and provider(e["guard"], []) != 0:
        sys.exit(0)
    if rest:
        k = find(rest[0], key)
        if k is None:
            sys.exit(f"Nothing called {rest[0]!r} in {e['label']}.")
        return run(k, rest[1:])
    kids = children(key)
    lines = "".join(f"{TREE[k]['label']}{'  ✓' if holds(TREE[k].get('checked')) and TREE[k].get('checked') else ''}\t{k}\n" for k in kids)
    p = subprocess.run(["amadeus-pick", "--global", e.get("title", e["label"])], input=lines, capture_output=True, text=True)
    if p.returncode != 0 or not p.stdout.strip():
        sys.exit(0)
    choice = p.stdout.strip().split("\n")[0]
    k = choice.split("\t")[1] if "\t" in choice else find(choice.removesuffix("  ✓"), key)
    if k in TREE:
        run(k, [])


def main():
    args = sys.argv[1:]
    if args[:1] == ["--menu-index"]:
        for k, e in TREE.items():
            print(f"{k}\t{e['label']}\t{path_of(k)}\t{e.get('keywords', '')}")
        return
    if args[:1] in (["--settings-index"], ["--default-types"]):
        sys.exit(provider(args[0][2:], []))
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__); return
    if not args:
        return run("", [])
    k = find(args[0])
    if k is None:
        sys.exit(f"The menu has no entry {args[0]!r}. amadeus-menu --menu-index lists them.")
    run(k, args[1:])


main()
