#!/bin/bash

# amadeus:summary=List themes that can style the Plymouth boot screen
# amadeus:examples=amadeus plymouth list

{
  find ~/.config/amadeus/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$AMADEUS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(amadeus-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
