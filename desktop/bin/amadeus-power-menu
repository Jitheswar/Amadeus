#!/bin/bash
# System menu (Super+Escape): lock, suspend, hibernate, log out, restart, shut down.
can() { [[ $(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "Can$1" 2>/dev/null) == 's "yes"' ]]; }
options=(Lock Suspend)
can Hibernate && options+=(Hibernate)     # offered only when this machine can actually do it
options+=("Log out" Restart "Shut down")
choice=$(printf '%s\n' "${options[@]}" | amadeus-pick System) || exit 0
case $choice in
  Lock) swaylock -f ;;
  Suspend) systemctl suspend ;;
  Hibernate) systemctl hibernate ;;
  "Log out") uwsm stop ;;
  Restart) systemctl reboot ;;
  "Shut down") systemctl poweroff ;;
esac
