#!/bin/bash

# amadeus:summary=Remove Tailscale and its bar plugin.
# amadeus:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now amadeus-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
amadeus-plugin-disable amadeus.tailscale
amadeus-webapp-remove "Tailscale" 2>/dev/null || true
amadeus-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
