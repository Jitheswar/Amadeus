#!/bin/bash

# amadeus:summary=Install and configure Hex dictation
# amadeus:requires-sudo=true

set -e

amadeus-pkg-add hex-bin
# Download the speech model here, with progress, instead of silently on first launch.
hex model install
systemctl --user enable hex.service
# Launching through the CLI saves this session's display environment for the unit before starting it.
hex start
amadeus-dictation-use hex
amadeus-restart-hyprctl
amadeus-notification-send -g  "$(amadeus-i18n dictation.hexReady)" "$(amadeus-i18n dictation.hint)" -t 10000
