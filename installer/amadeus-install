#!/bin/bash
# Amadeus OS installer. Erases one disk and installs the system onto it.
#   amadeus-install                 plain questions in the terminal (amadeus-setup is the guided way)
#   amadeus-install answers.conf    unattended (shell variables, see the README)
set -euo pipefail
SHARE=/usr/share/amadeus-install
T=/mnt/amadeus
LOG=/var/log/amadeus-install.log
exec > >(tee -a "$LOG") 2>&1

say()  { printf '\n\033[1;32m==>\033[0m %s\n' "$*"; }
die()  { printf '\n\033[1;31mInstall stopped:\033[0m %s\n' "$*" >&2; exit 1; }
pkgs() { grep -hv '^#' "$@" | tr '\n' ' '; }
ask()  { local var=$1 prompt=$2 def=${3:-} v; [[ -n ${!var:-} ]] && return; read -rp "$prompt${def:+ [$def]}: " v; printf -v "$var" '%s' "${v:-$def}"; }
ask_secret() { local var=$1 prompt=$2 a b; [[ -n ${!var:-} ]] && return
  while :; do read -rsp "$prompt: " a; echo; read -rsp "Again: " b; echo; [[ -n $a && $a == "$b" ]] && break; echo "Empty or not matching."; done
  printf -v "$var" '%s' "$a"; }

(( EUID == 0 )) || die "run as root"
[[ -d /sys/firmware/efi ]] || die "this machine did not boot in UEFI mode"
UNATTENDED=no
if [[ -n ${1:-} ]]; then source "$1"; UNATTENDED=yes; fi

# ---- questions ---------------------------------------------------------------
if [[ -z ${DISK:-} ]]; then
  say "Disks"
  lsblk -dno NAME,SIZE,MODEL,TRAN | grep -vE '^(loop|sr|zram)'
fi
ask DISK "Disk to ERASE and install onto (for example nvme0n1)"
DISK=/dev/${DISK#/dev/}
[[ -b $DISK ]] || die "$DISK is not a disk"
[[ $(lsblk -dno TYPE "$DISK") == disk ]] || die "$DISK is not a whole disk"
ask HOSTNAME "Computer name" amadeus
ask USERNAME "Your user name"
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || die "invalid user name"
ask_secret PASSWORD "Password for $USERNAME"
ask ENCRYPT "Encrypt the disk (yes/no)" yes
[[ $ENCRYPT == yes || $ENCRYPT == no ]] || die "encryption must be yes or no; nothing was changed"
[[ $ENCRYPT == yes ]] && LUKS_PASS=${LUKS_PASS:-$PASSWORD}
ask TIMEZONE "Time zone" "$(curl -fsm5 https://ipapi.co/timezone 2>/dev/null || echo UTC)"
[[ -f /usr/share/zoneinfo/$TIMEZONE ]] || die "unknown time zone $TIMEZONE"
ask LOCALE "Locale" en_US.UTF-8
ask KEYMAP "Console keymap" us
echo "The base desktop and default apps are installed either way."
ask EXTRAS "Add optional extras (Brave Origin, herdr, LocalSend) (yes/no)" yes
[[ $EXTRAS == yes || $EXTRAS == no ]] || die "EXTRAS must be yes or no; nothing was changed"
# A system on a USB drive is portable: it may start on a different computer from the one
# installing it, so the boot image covers any hardware and every maker's drivers are included.
PORTABLE=${PORTABLE:-auto}
case $PORTABLE in yes|no|auto) ;; *) die "PORTABLE must be yes, no or auto; nothing was changed" ;; esac
if [[ $PORTABLE == auto ]]; then
  [[ $(lsblk -dno TRAN "$DISK") == usb || $(lsblk -dno RM "$DISK") == 1 ]] && PORTABLE=yes || PORTABLE=no
fi
NVIDIA=${NVIDIA:-auto}
case $NVIDIA in yes|no|auto) ;; *) die "NVIDIA must be yes, no or auto; nothing was changed" ;; esac
# Drivers, firmware choices and fixes follow the hardware amadeus-hardware detects; the
# packages for each are in desktop/hardware/packages.list. NVIDIA=yes or no overrides its choice.
HW=()
[[ $PORTABLE == yes ]] && HW+=(--portable)
[[ $NVIDIA == yes ]] && HW+=(--with gpu-nvidia)
[[ $NVIDIA == no ]] && HW+=(--without gpu-nvidia --without gpu-nvidia-legacy)
hw() { amadeus-hardware "${HW[@]}" "$@"; }
echo "Hardware: $(hw | tr '\n' ' ')"

if [[ $UNATTENDED == no ]]; then
  say "This will permanently erase everything on $DISK:"
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK"
  read -rp "Type the disk name (${DISK#/dev/}) to continue: " confirm
  [[ $confirm == "${DISK#/dev/}" ]] || die "not confirmed; nothing was changed"
fi
# Packages built for newer processors are used when this processor can run them.
V3=no; /lib/ld-linux-x86-64.so.2 --help | grep 'x86-64-v3 (supported' >/dev/null && V3=yes
# The ISO carries every package the installation needs, for processors that can run the
# newer builds; the internet is then needed only for what is set up per user afterwards.
OFFLINE=no; [[ -f /opt/amadeus-offline/amadeus-offline.db.tar.gz && $V3 == yes ]] && OFFLINE=yes
ONLINE=no
{ ping -c1 -W5 archlinux.org || curl -fsm8 -o /dev/null https://geo.mirror.pkgbuild.com; } >/dev/null 2>&1 && ONLINE=yes
[[ $ONLINE == yes || $OFFLINE == yes ]] || die "no internet connection, and this processor needs packages from the internet (connect with: iwctl station wlan0 connect "NETWORK", then run again)"

# ---- disk --------------------------------------------------------------------
say "Partitioning $DISK"
umount -R $T 2>/dev/null || true
cryptsetup close root 2>/dev/null || true
wipefs -af "$DISK" >/dev/null
sgdisk -Z "$DISK" >/dev/null
sgdisk -n1:0:+2G -t1:ef00 -c1:EFI -n2:0:0 -t2:8304 -c2:amadeus "$DISK" >/dev/null
partprobe "$DISK"; udevadm settle
[[ $DISK =~ [0-9]$ ]] && P=${DISK}p || P=$DISK
ESP=${P}1 ROOTPART=${P}2
mkfs.fat -F32 -n EFI "$ESP" >/dev/null
if [[ $ENCRYPT == yes ]]; then
  say "Encrypting"
  printf '%s' "$LUKS_PASS" | cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$ROOTPART"
  printf '%s' "$LUKS_PASS" | cryptsetup open --allow-discards --key-file - "$ROOTPART" root
  ROOTDEV=/dev/mapper/root
else
  ROOTDEV=$ROOTPART
fi
mkfs.btrfs -qf -L amadeus "$ROOTDEV"
mount "$ROOTDEV" /mnt
for sv in @ @home @log @pkg; do btrfs subvolume create /mnt/$sv >/dev/null; done
umount /mnt
OPTS=noatime,compress=zstd:3,discard=async
mkdir -p $T
mount -o $OPTS,subvol=@ "$ROOTDEV" $T
mkdir -p $T/{boot,home,var/log,var/cache/pacman/pkg}
mount -o $OPTS,subvol=@home "$ROOTDEV" $T/home
mount -o $OPTS,subvol=@log "$ROOTDEV" $T/var/log
mount -o $OPTS,subvol=@pkg "$ROOTDEV" $T/var/cache/pacman/pkg
mount -o umask=0077 "$ESP" $T/boot

# ---- packages ----------------------------------------------------------------
say "Installing packages (this is the long part)"
# The CachyOS repositories: their signing key and mirror lists are on this medium.
pacman -U --noconfirm --needed /opt/amadeus-repo/cachyos-keyring-*.pkg.tar.zst /opt/amadeus-repo/cachyos-mirrorlist-*.pkg.tar.zst \
  /opt/amadeus-repo/cachyos-v3-mirrorlist-*.pkg.tar.zst >/dev/null
pacman-key --populate cachyos >/dev/null 2>&1
# Packages built for newer processors are used when this processor can run them.
ARCH="x86_64" REPOS=""
if [[ $V3 == yes ]]; then
  ARCH="x86_64 x86_64_v3"
  REPOS=$(for r in cachyos-v3 cachyos-core-v3 cachyos-extra-v3; do printf '[%s]\nInclude = /etc/pacman.d/cachyos-v3-mirrorlist\n' "$r"; done)
fi
REPOS+=$(printf '\n[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n')
CONF=$(mktemp)
if [[ $OFFLINE == yes ]]; then
  # Everything from the medium. The packages were checked against their signatures when the
  # ISO was built, and the medium itself is what is trusted here.
  {
    echo "[options]"; echo "Architecture = $ARCH"; echo "SigLevel = Optional TrustAll"; echo "LocalFileSigLevel = Optional"
    echo "CacheDir = /opt/amadeus-offline/"
    printf '[amadeus-offline]\nServer = file:///opt/amadeus-offline\n'
  } >"$CONF"
else
{
  echo "[options]"; echo "Architecture = $ARCH"; echo "ParallelDownloads = 8"; echo "SigLevel = Required DatabaseOptional"; echo "LocalFileSigLevel = Optional"
  # A cache that outlives this run comes first, so what is downloaded once is kept.
  for c in ${CACHE_DIR:-}; do [[ -d $c ]] && echo "CacheDir = $c/"; done
  echo "CacheDir = $T/var/cache/pacman/pkg/"
  echo "$REPOS"
  for r in core extra multilib; do printf '[%s]\nInclude = /etc/pacman.d/mirrorlist\n' "$r"; done
  # The hardware repository (and the T2 one on those Macs), after every other one.
  hw repos
} >"$CONF"
hw trust /
fi
LIST="$(pkgs $SHARE/packages.base $SHARE/packages.desktop $SHARE/packages.apps $SHARE/packages.system)"
# Drivers go in with everything else, wherever they come from: the medium carries all of them, and
# an online install has the hardware and T2 repositories configured above.
LIST+=" $(hw packages --plain | tr '\n' ' ')"
[[ $EXTRAS == yes ]] && LIST+=" $(pkgs $SHARE/packages.extras)"
# A stalled download should not end the install: what was fetched is kept, so retry.
for try in 1 2 3; do
  # shellcheck disable=SC2086
  pacstrap -C "$CONF" $T $LIST && break
  # From the medium there is nothing to retry: a failure there is the disk, and the lines above name it.
  [[ $OFFLINE == yes ]] && die "packages could not be written to $DISK. If the lines above say \"Input/output error\", the disk could not be written to; try another port or another disk"
  (( try < 3 )) || die "packages could not be downloaded; check the connection and run amadeus-install again"
  echo "  Download interrupted; trying again ($try of 2)."; sleep 5
done

# Amadeus itself and the applications that are not in the Arch repositories are on this
# medium. They are installed from their files directly, so a same-named package in a
# download cache can never be picked up in their place.
LOCAL=(/opt/amadeus-repo/amadeus-[0-9]*.pkg.tar.zst /opt/amadeus-repo/amadeus-desktop-[0-9]*.pkg.tar.zst)
if [[ $EXTRAS == yes ]]; then
  for p in $(pkgs $SHARE/packages.aur); do
    f=$(compgen -G "/opt/amadeus-repo/$p-[0-9]*.pkg.tar.zst" | head -1) || true
    [[ -n $f ]] && LOCAL+=("$f") || echo "  ($p is not on this medium; skipped)"
  done
fi
pacstrap -C "$CONF" -U $T "${LOCAL[@]}"

say "Configuring"
genfstab -U $T >>$T/etc/fstab
# Mount subvolumes by name only, so a rolled-back root (which gets a new id) still mounts.
sed -i -E 's/subvolid=[0-9]+,?//' $T/etc/fstab
ch() { arch-chroot $T "$@"; }
sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' $T/etc/pacman.conf
# The same repositories on the installed system, above the Arch ones so their builds are preferred.
sed -i "s/^Architecture = .*/Architecture = $ARCH/" $T/etc/pacman.conf
printf '%s\n' "$REPOS" >/tmp/cachyos-repos
python3 - $T/etc/pacman.conf <<'PY'
import sys
p = sys.argv[1]; s = open(p).read(); repos = open("/tmp/cachyos-repos").read().strip() + "\n\n"
if "[cachyos]" not in s:            # the pacman.conf that was installed may already list them
    i = s.index("[core]")
    s = s[:i] + repos + s[i:]
open(p, "w").write(s)
PY
sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 8/; s/^#Color/Color/' $T/etc/pacman.conf
# The hardware repository (and the T2 one on those Macs) stay on the new system, listed last so
# they never replace a package the others carry.
hw repos >>$T/etc/pacman.conf
hw trust $T
cp /etc/pacman.d/mirrorlist $T/etc/pacman.d/mirrorlist
ln -sf ../usr/lib/os-release.amadeus $T/etc/os-release
echo "$HOSTNAME" >$T/etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$HOSTNAME" >$T/etc/hosts
ln -sf "/usr/share/zoneinfo/$TIMEZONE" $T/etc/localtime
ch hwclock --systohc
sed -i "s/^#\($LOCALE\)/\1/; s/^#\(en_US.UTF-8\)/\1/" $T/etc/locale.gen
ch locale-gen >/dev/null
echo "LANG=$LOCALE" >$T/etc/locale.conf
echo "KEYMAP=$KEYMAP" >$T/etc/vconsole.conf

ch useradd -m -G wheel,video,input -s /bin/bash ${FULLNAME:+-c "$FULLNAME"} "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASSWORD" | ch chpasswd
ch passwd -l root >/dev/null
echo '%wheel ALL=(ALL:ALL) ALL' >$T/etc/sudoers.d/10-wheel; chmod 440 $T/etc/sudoers.d/10-wheel
# A fresh install already has every settings change in it; amadeus-update runs only later ones.
ch runuser -u "$USERNAME" -- env HOME="/home/$USERNAME" amadeus-migrate --mark-all

printf '[zram0]\nzram-size = min(ram, 8192)\ncompression-algorithm = zstd\n' >$T/etc/systemd/zram-generator.conf
printf 'vm.swappiness = 150\nvm.page-cluster = 0\n' >$T/etc/sysctl.d/90-zram.conf
mkdir -p $T/etc/systemd/journald.conf.d $T/etc/NetworkManager/conf.d
printf '[Journal]\nSystemMaxUse=200M\n' >$T/etc/systemd/journald.conf.d/size.conf
printf '[connection]\nwifi.powersave = 3\n' >$T/etc/NetworkManager/conf.d/wifi-powersave.conf

# The login screen. On an encrypted disk the passphrase typed at boot already proved who is
# there, so the desktop starts straight away; otherwise the Amadeus login screen asks.
if [[ $ENCRYPT == yes ]]; then
  printf '[Autologin]\nUser=%s\nSession=amadeus\n' "$USERNAME" >$T/etc/sddm.conf.d/autologin.conf
fi

# Driver settings, services and model-specific fixes for the detected hardware (before the
# boot image is built, since some add modules to it).
AMADEUS_HARDWARE_SHARE=$T/usr/share/amadeus-os/hardware hw apply $T

# ---- boot --------------------------------------------------------------------
say "Boot loader"
# Limine, with a unified kernel image per kernel and a Snapshots submenu that boots any system
# snapshot read-only (btrfs-overlayfs); the look and the splash options come from the shipped
# /etc/limine-entry-tool.d drop-ins and /usr/share/amadeus/default/limine.
if [[ $ENCRYPT == yes ]]; then
  CMD="cryptdevice=UUID=$(blkid -s UUID -o value "$ROOTPART"):root:allow-discards root=/dev/mapper/root"
else
  CMD="root=UUID=$(blkid -s UUID -o value "$ROOTDEV")"
fi
CMD+=" rootflags=subvol=@ rw rootfstype=btrfs $(hw cmdline) ${EXTRA_CMDLINE:-}"
sed "s|@@CMDLINE@@|${CMD% }|" $T/usr/share/amadeus/default/limine/default.conf >$T/etc/default/limine
# autodetect keeps only the drivers this computer needs; a portable system needs them all.
[[ $PORTABLE == yes ]] && printf '%s\n' '# A portable system starts on any computer, so its boot image keeps every driver.' \
  'HOOKS=("${HOOKS[@]/autodetect}")' >$T/etc/mkinitcpio.conf.d/zz-amadeus-portable.conf
K=linux-cachyos
[[ -f $T/boot/vmlinuz-$K ]] || die "the kernel $K was not installed; see the package messages above"
install -m644 $T/usr/share/amadeus/default/limine/limine.conf $T/boot/limine.conf
# The boot splash (and the disk passphrase prompt) in the Amadeus look; the boot images built next carry it.
ch plymouth-set-default-theme amadeus
ch limine-install >/dev/null 2>&1 || ch limine-install
ch limine-mkinitcpio >/dev/null 2>&1 || ch limine-mkinitcpio

# ---- snapshots and services --------------------------------------------------
say "Snapshots and services"
# The desktop system's own setup: snapshot retention (the newest five; amadeus-update takes
# them), firewall, services, sign-in limits, SSH, locale, the login screen, device rules and
# the file index. Its package-channel step is not run: the repositories set up above stay.
ch env AMADEUS_PATH=/usr/share/amadeus AMADEUS_INSTALL=/usr/share/amadeus/install AMADEUS_LOG_TO_STDOUT=1 bash -c '
  source "$AMADEUS_INSTALL/helpers/logging.sh"
  source "$AMADEUS_INSTALL/config/all.sh"
  source "$AMADEUS_INSTALL/login/all.sh"
  run_logged "$AMADEUS_INSTALL/post-install/udev.sh"
  run_logged "$AMADEUS_INSTALL/post-install/localdb.sh"' || die "the system setup steps failed; see the messages above"
for s in bluetooth ananicy-cpp systemd-timesyncd fstrim.timer; do
  ch systemctl enable "$s" >/dev/null 2>&1 || echo "  (could not enable $s)"
done
ln -sf ../run/systemd/resolve/stub-resolv.conf $T/etc/resolv.conf
ch systemctl --global enable amadeusd.service pipewire.socket pipewire-pulse.socket wireplumber.service >/dev/null 2>&1 || true
# The new user's own setup: the default theme, browser extensions, input methods, keyring,
# mise and the per-user hardware fixes.
ch runuser -u "$USERNAME" -- env HOME="/home/$USERNAME" AMADEUS_PATH=/usr/share/amadeus \
  AMADEUS_USER_NAME="${FULLNAME:-$USERNAME}" amadeus-provision-user --first-install || die "the user setup failed; see the messages above"

# The Install menu and amadeus-catalog read pacman's package lists. An install from the
# medium leaves none for the repositories the new system uses, so fetch them now when
# there is a connection, or copy the medium's Arch lists when there is not.
say "Package lists"
if [[ $ONLINE == yes ]]; then
  ch pacman -Sy --noconfirm >/dev/null 2>&1 || echo "  The package lists could not be fetched; the first update will fetch them."
else
  mkdir -p $T/var/lib/pacman/sync
  # The medium carries the lists that match the packages it installed.
  python3 "$SHARE/amadeus-seed-package-lists" /opt/amadeus-offline/sync "$T/var/lib/pacman/sync" ||
    echo "  The package lists could not be copied; the first update will fetch them."
  [[ -n $(ls $T/var/lib/pacman/sync/*.db 2>/dev/null) ]] || echo "  Install will show no packages until you update with a connection."
fi

[[ -n ${POST_HOOK:-} && -x ${POST_HOOK:-} ]] && "$POST_HOOK" $T "$USERNAME"

install -Dm644 "$LOG" $T/var/log/amadeus-install.log
sync
umount -R $T
[[ $ENCRYPT == yes ]] && cryptsetup close root
say "Amadeus OS is installed on $DISK. Remove the USB stick and restart."
echo "    El Psy Kongroo."
