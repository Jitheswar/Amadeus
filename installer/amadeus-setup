#!/bin/bash
# Guided installation of Amadeus OS: starts by itself when the USB stick boots, asks a few questions, then installs.
# Every answer has a sensible default. Nothing on any disk changes until you confirm the summary.
# Leave at any time with Ctrl+C; you get a shell, and `amadeus-setup` starts again.
set -uo pipefail
ACCENT='#ffa14a' DIM='#9c948a' FG='#f1ebe1' BAD='#ff6b5e'
export GUM_INPUT_CURSOR_FOREGROUND=$ACCENT GUM_INPUT_PROMPT_FOREGROUND=$ACCENT GUM_INPUT_HEADER_FOREGROUND=$FG \
       GUM_CHOOSE_CURSOR_FOREGROUND=$ACCENT GUM_CHOOSE_SELECTED_FOREGROUND=$ACCENT GUM_CHOOSE_HEADER_FOREGROUND=$FG \
       GUM_FILTER_INDICATOR_FOREGROUND=$ACCENT GUM_FILTER_MATCH_FOREGROUND=$ACCENT GUM_FILTER_HEADER_FOREGROUND=$FG \
       GUM_FILTER_PROMPT_FOREGROUND=$ACCENT GUM_CONFIRM_PROMPT_FOREGROUND=$FG GUM_CONFIRM_SELECTED_BACKGROUND=$ACCENT \
       GUM_CONFIRM_SELECTED_FOREGROUND='#0f0e0d' GUM_SPIN_SPINNER_FOREGROUND=$ACCENT

STEPS=(Keyboard Internet You Time Disk Extras)
# Every page: the wordmark with the worldline number, then the steps as one line, lit up to where you are.
screen() {   # screen STEP_NUMBER (1-6, 0 for none, 7 for all done) [HEADING]
  local at=${1:-0} i mark colour line=""
  [[ -n ${NOCLEAR:-} ]] || clear; echo
  gum join --horizontal \
    "$(gum style --margin "0 0 0 2" --foreground "$ACCENT" --bold "A M A D E U S")" \
    "$(gum style --margin "0 0 0 4" --foreground "$DIM" "worldline")" \
    "$(gum style --margin "0 0 0 1" --foreground "$ACCENT" "1.048596")"
  if (( at > 0 )); then
    for i in "${!STEPS[@]}"; do
      if (( i + 1 < at )); then mark="●" colour=$ACCENT; elif (( i + 1 == at )); then mark="◉" colour=$FG; else mark="○" colour=$DIM; fi
      line+="$(gum style --foreground "$colour" "$mark ${STEPS[$i]}")"
      (( i < ${#STEPS[@]} - 1 )) && line+="$(gum style --foreground "$( (( i + 1 < at )) && echo "$ACCENT" || echo "$DIM")" " ─── ")"
    done
    echo; gum style --margin "0 2" "$line"
  fi
  [[ -n ${2:-} ]] && { echo; gum style --margin "0 2" --foreground "$FG" --bold "${2}"; }
  echo
}
note() { gum style --margin "0 2" --foreground "$DIM" "$@"; }
fail() { gum style --margin "1 2" --foreground "$BAD" "$@"; }
input() { gum input --width 50 --prompt "  › " "$@"; }

# On the boot screen: a larger font, and the console's sixteen colours replaced by the system's
# own, so warm black, amber and off-white come out exactly (a terminal shows these as they are).
if [[ $(tty) == /dev/tty* ]]; then
  setfont ter-v24b 2>/dev/null || setfont ter-v22b 2>/dev/null
  for c in 0:0f0e0d 1:ff6b5e 3:ffa14a 7:d9d2c7 8:9c948a 9:ff6b5e 11:ffa14a 15:f1ebe1; do printf '\e]P%x%s' "${c%%:*}" "${c#*:}"; done
  printf '\e[?25l'; trap 'printf "\e[?25h"' EXIT
fi
export GUM_INPUT_PLACEHOLDER_FOREGROUND=$DIM GUM_FILTER_PLACEHOLDER_FOREGROUND=$DIM GUM_CHOOSE_ITEM_FOREGROUND=$FG \
       GUM_CONFIRM_UNSELECTED_FOREGROUND=$DIM GUM_FILTER_TEXT_FOREGROUND=$FG

# ---- welcome
screen 0
[[ -r /usr/share/amadeus/logo.txt ]] && gum style --margin "0 2" --foreground "$ACCENT" "$(cat /usr/share/amadeus/logo.txt)"
gum style --margin "1 2" --padding "1 3" --border thick --border-foreground "$ACCENT" --foreground "$FG" \
  "This installs Amadeus OS on this computer." "" \
  "Six short questions, then about ten minutes of installing." "Nothing changes on any disk until you confirm at the end."
gum style --margin "0 2" --foreground "$DIM" --italic "El Psy Kongroo."
echo; gum confirm --affirmative "Begin" --negative "Not now" "  Ready?" || { clear; echo "Run amadeus-setup to begin."; exit 0; }

# ---- keyboard
screen 1 "Which keyboard do you type on?"
KEYMAP=$( { echo us; localectl list-keymaps 2>/dev/null | grep -vx us; } | gum filter --height 12 --placeholder "Type to search" --header "  Keyboard layout") || KEYMAP=us
loadkeys "$KEYMAP" 2>/dev/null

# ---- network
online() { curl -fsm6 -o /dev/null https://geo.mirror.pkgbuild.com; }
# With the packages on the medium, the internet is optional: it is used afterwards, for updates.
offline_ok() { [[ -f /opt/amadeus-offline/amadeus-offline.db.tar.gz ]] && /lib/ld-linux-x86-64.so.2 --help | grep 'x86-64-v3 (supported' >/dev/null; }
while ! online; do
  screen 2 "Connect to the internet"
  if offline_ok; then
    note "Everything needed to install is on this USB stick. Connecting now is optional;" "you can connect later from the bar."
    echo
    gum confirm --affirmative "Continue without internet" --negative "Connect now" "  " && break
  fi
  dev=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '$2 == "station" || /station/ {print $1; exit}')
  [[ -z $dev ]] && dev=$(ls /sys/class/net | grep -m1 '^wl')
  if [[ -z $dev ]]; then
    fail "No internet connection and no Wi-Fi found." ; note "Plug in a network cable, then press Enter."; read -r; continue
  fi
  iwctl station "$dev" scan 2>/dev/null; sleep 2
  net=$(iwctl station "$dev" get-networks 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tail -n +5 | sed 's/^[ >]*//' |
        awk 'NF >= 3 { $NF = ""; $(NF) = ""; sub(/[ \t]+(psk|open|8021x)[ \t]*$/, ""); print }' | sed 's/[[:space:]]*$//' | grep . |
        gum choose --height 12 --header "  Choose a Wi-Fi network") || continue
  pass=$(input --password --header "  Password for $net (leave empty if it has none)")
  if [[ -n $pass ]]; then iwctl --passphrase "$pass" station "$dev" connect "$net" 2>/dev/null
  else iwctl station "$dev" connect "$net" 2>/dev/null; fi
  gum spin --title "  Connecting to $net" -- sleep 5
  online || { fail "Could not reach the internet through $net."; sleep 2; }
done

# ---- you
screen 3 "Who will use this computer?"
FULL=$(input --header "  Your name" --placeholder "as it should appear on the login screen") || exit 1
# The name you sign in with comes from your name; change it only if you want something else.
USERNAME=$(tr 'A-Z' 'a-z' <<<"${FULL%% *}" | tr -cd 'a-z0-9_-')
if [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] && gum confirm --affirmative "Yes" --negative "Choose another" "  You will sign in as $USERNAME."; then :
else
  while :; do
    USERNAME=$(input --header "  The name you sign in with" --placeholder "lower-case letters and digits") || exit 1
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] && break
    fail "Use lower-case letters, digits, - and _, starting with a letter."
  done
fi
while :; do
  PASSWORD=$(input --password --header "  Password (also unlocks the disk)") || exit 1
  again=$(input --password --header "  The same password again") || exit 1
  [[ -n $PASSWORD && $PASSWORD == "$again" ]] && break
  fail "Empty, or the two did not match."
done
HOSTNAME=$(input --header "  Name of this computer" --value "amadeus") || exit 1
HOSTNAME=${HOSTNAME:-amadeus}

# ---- time
screen 4 "Where are you?"
guess=$(curl -fsm5 https://ipapi.co/timezone 2>/dev/null); [[ -f /usr/share/zoneinfo/$guess ]] || guess=UTC
TIMEZONE=$( { echo "$guess"; timedatectl list-timezones | grep -vx "$guess"; } | gum filter --height 12 --placeholder "Type a city" --header "  Time zone (detected: $guess)") || TIMEZONE=$guess

# ---- disk
screen 5 "Where should Amadeus live?"
line=$(lsblk -dpno NAME,SIZE,MODEL,TRAN | grep -vE '^/dev/(loop|sr|zram)' | grep -v "$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null | sed 's/[0-9]*$//; s/p$//')" |
       awk '{ name = $1; size = $2; $1 = $2 = ""; printf "%-14s %8s  %s\n", name, size, $0 }' |
       gum choose --height 8 --header "  Install on which disk? Everything on it will be erased.") || exit 1
DISK=${line%% *}
encryption=$(gum choose --header "  Protect the contents of this disk with your password?" \
  "Encrypt the disk (recommended)" "Leave the disk unencrypted") || exit 1
case $encryption in
  "Encrypt the disk (recommended)") ENCRYPT=yes ;;
  "Leave the disk unencrypted") ENCRYPT=no ;;
  *) exit 1 ;;
esac

# ---- applications
screen 6 "Optional extras"
note "The base desktop and default apps are installed either way, including btop and fastfetch." \
     "Steam and chat clients are available later from Gaming and Chat in the Amadeus menu." \
     "Claude Desktop is optional under Install > AI; Claude Code is under Install > Harness."
echo
note "Brave Origin and LocalSend come from the CachyOS repositories; herdr is packaged from its publisher's release."
extras=$(gum choose --header "  Install Brave Origin, herdr and LocalSend?" \
  "Include them" "Leave them out") || exit 1
case $extras in
  "Include them") EXTRAS=yes ;;
  "Leave them out") EXTRAS=no ;;
  *) exit 1 ;;
esac

# ---- summary
screen 7 "Ready"
# What the installer found, so the drivers it is about to install are no surprise.
hardware=$(amadeus-hardware 2>/dev/null | sed -n 's/^gpu-\(intel\|amd\|nvidia\|nvidia-legacy\)$/\1/p' | sed 's/nvidia-legacy/NVIDIA (older)/; s/nvidia/NVIDIA/; s/intel/Intel/; s/amd/AMD/' | paste -sd+ | sed 's/+/ + /g')
row() { printf '%s  %s' "$(gum style --foreground "$DIM" "$(printf '%-16s' "$1")")" "$(gum style --foreground "$FG" "$2")"; }
gum style --margin "0 2" --border thick --border-foreground "$ACCENT" --padding "1 3" \
  "$(row Name "$FULL ($USERNAME)")" "$(row Computer "$HOSTNAME")" "$(row Keyboard "$KEYMAP")" "$(row "Time zone" "$TIMEZONE")" \
  "$(row Disk "$line")" "$(row Encrypted "$ENCRYPT")" "$(row Graphics "${hardware:-built-in}")" \
  "$(row "Optional extras" "$([[ $EXTRAS == yes ]] && echo included || echo "left out")")"
echo
gum style --margin "0 2" --foreground "$BAD" "Everything on ${DISK#/dev/} will be permanently erased."
confirm=$(input --header "  Type ${DISK#/dev/} to install, or leave empty to go back" --placeholder "${DISK#/dev/}") || exit 1
[[ $confirm == "${DISK#/dev/}" ]] || exec "$0"

# ---- install: a progress page instead of a scroll of package names
answers=$(mktemp /run/amadeus-answers.XXXXXX); chmod 600 "$answers"
{ printf '%s=%q\n' DISK "$DISK" HOSTNAME "$HOSTNAME" USERNAME "$USERNAME" FULLNAME "$FULL" PASSWORD "$PASSWORD" \
    ENCRYPT "$ENCRYPT" TIMEZONE "$TIMEZONE" LOCALE en_US.UTF-8 KEYMAP "$KEYMAP" EXTRAS "$EXTRAS"; } >"$answers"
unset PASSWORD again
LOG=/var/log/amadeus-install.log; : >"$LOG"
amadeus-install "$answers" >/dev/null 2>&1 & job=$!
# The installer announces each phase with a "==>" line; these are the ones shown, in order.
PHASES=("Partitioning:Preparing the disk" "Encrypting:Encrypting" "Installing packages:Installing Amadeus OS" "Configuring:Setting it up for you"
        "Boot loader:Making it start" "Snapshots and services:Turning on the desktop and snapshots" "Package lists:Preparing optional software")
# Drawn with plain terminal codes, twice a second: no helper programs are started per frame.
esc() { printf '\e[38;2;%d;%d;%dm' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }
A=$(esc "$ACCENT") F=$(esc "$FG") G=$(esc "$DIM") R=$'\e[0m' B=$'\e[1m'
frame=0 spin='◐◓◑◒' start=$SECONDS shown=${#PHASES[@]}
[[ $ENCRYPT == yes ]] || shown=$((shown - 1))
clear; screen 7 "Installing"; printf '\e[s'
while kill -0 "$job" 2>/dev/null; do
  now=$(grep -a '==>' "$LOG" | tail -1 | sed 's/\x1b\[[0-9;]*m//g; s/.*==> //')
  last=$(tail -c 4000 "$LOG" | tr '\r' '\n' | sed 's/\x1b\[[0-9;]*m//g' | grep -av '^\s*$' | tail -1 | cut -c1-70)
  reached=-1 done=0
  for i in "${!PHASES[@]}"; do [[ $now == "${PHASES[$i]%%:*}"* ]] && reached=$i; done
  out='\e[u'
  for i in "${!PHASES[@]}"; do
    [[ $i == 1 && $ENCRYPT != yes ]] && continue
    p=${PHASES[$i]#*:}
    if (( i < reached )); then out+="    ${A}●  $p${R}\e[K\n"; done=$((done + 1))
    elif (( i == reached )); then out+="    ${F}${B}${spin:frame%4:1}  $p${R}\e[K\n"
    else out+="    ${G}○  $p${R}\e[K\n"; fi
  done
  width=40 fill=$(( done * width / shown ))
  bar=$(printf '%*s' "$fill" '' | tr ' ' '█')$(printf '%*s' "$((width - fill))" '' | tr ' ' '░')
  out+="\n    ${A}${bar}${R}  ${F}$(( done * 100 / shown ))%${R}\e[K\n"
  out+="\n    ${G}$(printf '%d:%02d' $(( (SECONDS - start) / 60 )) $(( (SECONDS - start) % 60 )))   ${last:- }${R}\e[K\e[J"
  printf '%b' "$out"
  frame=$((frame + 1)); sleep 0.5
done
wait "$job"; code=$?
rm -f "$answers"
if (( code == 0 )); then
  screen 7 "Installed"
  gum style --margin "0 2" --padding "1 3" --border thick --border-foreground "$ACCENT" --foreground "$FG" \
    "Amadeus OS is on ${DISK#/dev/}." "" "Remove the USB stick, then restart." \
    "$([[ $ENCRYPT == yes ]] && echo "At the first start, type your password to unlock the disk; the desktop opens straight after." || echo "At the first start, sign in with the password you chose.")"
  gum style --margin "0 2" --foreground "$DIM" --italic "El Psy Kongroo."
  echo; gum confirm --affirmative "Restart now" --negative "Stay here" "  " && reboot
else
  screen 7 "The installation stopped"
  gum style --margin "0 2" --foreground "$BAD" "Nothing is installed. The last lines of the log say why:"
  echo; tail -n 15 "$LOG" | sed 's/\x1b\[[0-9;]*m//g' | gum style --margin "0 4" --foreground "$DIM"
  echo; note "The full log is /var/log/amadeus-install.log. Run amadeus-setup to start again."
fi
