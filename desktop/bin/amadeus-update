#!/bin/bash

# amadeus:summary=Update the whole system: packages, settings changes, drivers, AUR apps and tools, with a snapshot first
# Steps in order: free space, package cache, snapshot, mirrors and signing keys, system packages,
# settings changes (amadeus-migrate), orphans, drivers this hardware lacks (amadeus-hardware),
# service restarts, your post-update hooks, mise tools, AUR apps, a boot check, then a restart offer.
# In the try session nothing is kept after a restart, so no snapshot is taken there.
# amadeus:alias=amadeus up
# amadeus:args=[-y]
# amadeus:examples=amadeus update | amadeus update -y
# amadeus:requires-sudo=true

set -e

update_stay_awake_stopped=0
sudo_keepalive_pid=""

# Ask for the password once, then keep sudo's timestamp fresh so long package
# downloads, migrations, hooks, and mise never outlast it and prompt again.
# Authorize by running a command rather than sudo -v: under the default
# verifypw=all, -v prompts even when passwordless sudo is enabled.
authorize_update() {
  sudo true || return 1

  local update_pid=$$
  (
    [[ -z ${AMADEUS_UPDATE_LOCK_FD:-} ]] || exec {AMADEUS_UPDATE_LOCK_FD}>&-
    sleep_pid=""
    trap - EXIT HUP INT
    trap '[[ -z $sleep_pid ]] || kill "$sleep_pid" 2>/dev/null; exit 0' TERM
    while :; do
      sleep 60 &
      sleep_pid=$!
      wait "$sleep_pid"
      kill -0 "$update_pid" 2>/dev/null || exit 0
      sudo -n true 2>/dev/null || exit 0
    done
  ) &
  sudo_keepalive_pid=$!
}

end_update_authorization() {
  if [[ -n $sudo_keepalive_pid ]]; then
    kill "$sudo_keepalive_pid" 2>/dev/null || true
    wait "$sudo_keepalive_pid" 2>/dev/null || true
    sudo_keepalive_pid=""
  fi
}

cleanup_update() {
  local status=$?
  trap - EXIT HUP INT TERM
  end_update_authorization
  if (( update_stay_awake_stopped == 0 )); then
    amadeus-update-stay-awake stop || status=1
  fi
  exit "$status"
}

if [[ -z ${AMADEUS_UPDATE_LOGGED:-} ]]; then
  # Keep an untrapped shell as the PTY session leader. If script disappears,
  # its hangup must reach the foreground prompt, not wait on our signal traps.
  # script uses SHELL to interpret this Bash command; restore the caller's
  # value inside it so hooks and package builds keep their original environment.
  if [[ ${SHELL@a} == *x* ]]; then
    printf -v script_command 'export SHELL=%q; ' "$SHELL"
  else
    script_command='unset SHELL; '
  fi
  script_command+="$(printf '%q ' "$0" "$@"); exit \$?"
  exec env AMADEUS_UPDATE_LOGGED=1 SHELL=/usr/bin/bash script -qefc "$script_command" "/tmp/amadeus-update.log"
fi

if ! amadeus-update-lock held; then
  exec amadeus-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://github.com/Jitheswar/Amadeus/issues"' ERR
trap cleanup_update EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

amadeus-update-requires-free-space

# -y skips the start confirmation and, unless the caller set
# AMADEUS_UPDATE_UNATTENDED itself, suppresses Amadeus confirmation prompts;
# sudo authorization is still required. Interactive review steps report and
# move on instead of waiting.
[[ ${1:-} != "-y" ]] || export AMADEUS_UPDATE_UNATTENDED=${AMADEUS_UPDATE_UNATTENDED:-1}

if [[ ${1:-} == "-y" ]] || amadeus-update-confirm; then
  authorize_update

  # Before the snapshot: the cache is on the snapshotted subvolume, so pruning
  # after it frees nothing until that snapshot ages out.
  amadeus-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  if [[ -e ${AMADEUS_TRY_MARKER:-/run/amadeus-try} ]]; then
    echo "Try session: no snapshot is taken, and everything updated here lasts until you restart."
  else
    amadeus-snapshot create || (($? == 127)) ||
      echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2
  fi

  amadeus-update-stay-awake start

  # The fastest official mirrors (ranked once a month), then any development checkout, then the
  # Arch, CachyOS and hardware-repository signing keys, so packages signed by a new key install in this run.
  sudo amadeus-mirrors || echo -e "\e[33mThe mirrors were not ranked again; the current list stays.\e[0m" >&2
  amadeus-update-dev
  amadeus-update-keyring

  # Migrations ship with the packages installed here and are written against
  # them, so everything below waits on this finishing. An upgrade that stopped
  # takes the update with it rather than migrating against what is still on disk.
  amadeus-update-system-pkgs

  # Migrations call the shell over IPC, so give them one running current code.
  if amadeus-migrate --pending >/dev/null; then
    amadeus-restart-shell || true
  fi
  amadeus-migrate
  amadeus-update-orphan-pkgs -y

  # Drivers new to this release, or for hardware added since the last update.
  if [[ -n $(amadeus-hardware missing 2>/dev/null) ]]; then
    amadeus-hardware setup
  fi

  amadeus-update-analyze-logs

  # The full upgrade went through, so there is no update left to show in the bar.
  amadeus-shell -q amadeus.system-update clear

  # Service restart helpers can need sudo. The reboot-only phase below
  # performs no privileged work.
  amadeus-update-restart --services-only

  amadeus-hook post-update
  # Optional tool downloads must not skip boot verification or the reboot
  # prompt after system packages have already been upgraded.
  mise_updated=1
  amadeus-update-mise || mise_updated=0

  # AUR packages build against the upgraded system, so they go after it, and
  # share the update's one authorization like every step before them.
  amadeus-update-aur-pkgs

  # The last sudo-capable step: the boot files every package step left, AUR
  # packages' initramfs rebuilds included, must be shown to boot the updated
  # system. Until it passes, the update neither finishes nor offers a reboot.
  boot_verified=1
  amadeus-update-boot || boot_verified=0
  end_update_authorization

  # The sleep inhibitor covers AUR builds, hooks and mise as well. Release it
  # before offering a reboot: a confirmed reboot can terminate this
  # process before its EXIT trap gets a chance to remove the persistent Stay
  # Awake marker.
  amadeus-update-stay-awake stop
  update_stay_awake_stopped=1

  if (( mise_updated == 0 )); then
    echo -e "\e[33m\nSome mise tools could not be updated. Review the errors above and run 'amadeus update mise' to retry.\e[0m" >&2
  fi

  if (( boot_verified )); then
    "$AMADEUS_PATH/bin/amadeus-update-restart" --reboot-only
  else
    echo -e "\e[31m\nThe update is not finished: its boot files did not pass verification (see above). Do not reboot until amadeus update completes.\e[0m" >&2
    exit 1
  fi
fi
