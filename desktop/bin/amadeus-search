#!/usr/bin/python3
# Find installed applications and Amadeus menu entries, for the assistant and other callers.
"""amadeus-search --index | --run ID

--index prints every installed application and every entry of the Amadeus menu as JSON
(id, label, where it is, search words). --run opens one: an application starts, a menu
entry opens the menu there. Only IDs from the index are accepted."""
import json, os, re, subprocess, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
MENU = Path(os.environ.get("AMADEUS_MENU_FILE") or next(
    (p for p in (Path("/usr/share/amadeus/default/amadeus/amadeus-menu.jsonc"),
                 HERE.parent / "system/usr/share/amadeus/default/amadeus/amadeus-menu.jsonc") if p.exists()),
    Path("/usr/share/amadeus/default/amadeus/amadeus-menu.jsonc")))


def jsonc(text):
    """JSON with // comments and trailing commas; comment markers inside strings are kept."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1]); i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True; out.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))


def menu_entries():
    try:
        tree = jsonc(MENU.read_text())
    except (OSError, ValueError):
        return {}
    entries = {}
    for key, e in tree.items():
        names, k = [], key.rpartition(".")[0]
        while k:
            names.insert(0, tree.get(k, {}).get("label", k)); k = k.rpartition(".")[0]
        entries[key] = {"label": e.get("label", key), "path": " › ".join(["Amadeus"] + names),
                        "keywords": " ".join(e.get("aliases", []) + e.get("searchTerms", []) + [key.replace(".", " ")])}
    return entries


def index():
    result = []
    p = subprocess.run(["amadeus-launcher", "--json"], capture_output=True, text=True, timeout=10)
    if p.returncode == 0:
        for app in json.loads(p.stdout):
            result.append(dict(app, id="app:" + app["id"], kind=app.get("kind", "Application"), path="Apps",
                               description=app.get("description", ""), keywords=app.get("keywords", "") + " " + app["id"]))
    for key, e in menu_entries().items():
        result.append({"id": "menu:" + key, "kind": "Menu", **e})
    for item in result:
        item["label"] = " ".join(str(item["label"]).split())[:160]
        item["keywords"] = str(item.get("keywords", ""))[:500]
    return result


def main():
    if sys.argv[1:] == ["--index"]:
        print(json.dumps(index()))
        return
    if len(sys.argv) == 3 and sys.argv[1] == "--run":
        key = sys.argv[2]
        if key.startswith("app:"):
            command = ["amadeus-launcher", "--launch", key[4:]]
        elif key.startswith("menu:") and key[5:] in menu_entries():
            command = ["amadeus-menu", "summon", key[5:]]
        else:
            sys.exit("That search result is no longer available.")
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return
    print(__doc__)


if __name__ == "__main__":
    main()
