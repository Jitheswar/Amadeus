#!/bin/bash
# Root side of amadeus-sudo. Writes or removes one sudoers rule for one user, and nothing else.
#   sudo-helper on 15m|30m|1h|always USER      sudo-helper off      sudo-helper boot
set -euo pipefail
rule=/etc/sudoers.d/90-amadeus-passwordless
mode=/var/lib/amadeus-os/sudo-mode
state=/run/amadeus-sudo
off() { rm -f "$rule" "$mode" "$state"; systemctl stop amadeus-sudo-off.timer 2>/dev/null || true; }
case ${1:-} in
  on)
    case ${2:-} in 15m) secs=900 ;; 30m) secs=1800 ;; 1h) secs=3600 ;; always) secs=0 ;; *) exit 1 ;; esac
    user=${3:?}; id "$user" >/dev/null && [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || exit 1
    off
    tmp=$(mktemp); printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$user" >"$tmp"
    visudo -cf "$tmp" >/dev/null && install -m 440 "$tmp" "$rule"; rm -f "$tmp"
    mkdir -p "$(dirname "$mode")"
    if (( secs )); then
      echo timed >"$mode"; echo $(( $(date +%s) + secs )) >"$state"
      systemd-run --quiet --unit amadeus-sudo-off --on-active="$secs" /usr/lib/amadeus-os/sudo-helper off
    else
      echo always >"$mode"; echo always >"$state"
    fi
    chmod 644 "$state" ;;
  off) off ;;
  boot)  # a timed setting never survives a restart; a permanent one is shown again
    if [[ $(cat "$mode" 2>/dev/null) == always && -f $rule ]]; then echo always >"$state"; chmod 644 "$state"; else off; fi ;;
  *) exit 1 ;;
esac
