#!/bin/bash
# The install catalogue: named lists of software (terminals, browsers, editors, AI apps, development tools).
#   amadeus-catalog                    the categories
#   amadeus-catalog CATEGORY           what can be installed, with what is already installed marked
#   amadeus-catalog info 'LINE'        details for one line of a list
#   amadeus-catalog install 'LINE'...  install; system packages first, then AUR recipes, then mise tools
# Each entry names its sources best first: the system repositories, then an AUR recipe, then mise.
# The first source that still exists is used, so a renamed or removed package drops out by itself.
set -euo pipefail
DIR=${AMADEUS_CATALOG:-/usr/share/amadeus-os/catalog}
[[ -d $DIR ]] || { echo "No install catalogue is installed at $DIR." >&2; exit 1; }
# Each source is asked once for everything it has: one query per entry made a category
# take seconds to open.
declare -A in_repo=() in_system=() in_mise=() in_tools=() in_aur=()
load() {
  local repo name _ wanted
  # The sources list far more than a category asks about: keep only the names it mentions.
  wanted=$(grep -v '^#' "$1" | grep -oE '(pacman|aur|mise):[^[:space:]]+' | cut -d: -f2- | tr '+' '\n' | sed 's|.*/||' | sort -u)
  [[ -n $wanted ]] || return 0
  while read -r repo name _; do in_repo[$name]=1; in_repo[$repo/$name]=1; done < <(pacman -Sl 2>/dev/null | grep -wFf <(echo "$wanted") || true)
  while read -r name; do in_system[$name]=1; done < <(pacman -Qq 2>/dev/null | grep -xFf <(echo "$wanted") || true)
  while read -r name _; do in_mise[$name]=1; done < <(mise registry 2>/dev/null | grep -wFf <(echo "$wanted") || true)
  while read -r name _; do in_tools[$name]=1; done < <(mise ls --global 2>/dev/null | grep -wFf <(echo "$wanted") || true)
  while read -r name; do in_aur[$name]=1; done < <(amadeus-aur list 2>/dev/null | grep -xFf <(echo "$wanted") || true)
}
all_in_repo() { local n; for n in ${1//+/ }; do [[ -n ${in_repo[$n]:-} ]] || return 1; done; }

# The first source in a list that exists right now.
resolve() {
  local s
  for s in $1; do
    case $s in
      pacman:*) all_in_repo "${s#pacman:}" && { echo "$s"; return; } ;;
      aur:*)    [[ -n ${in_aur[${s#aur:}]:-} ]] && { echo "$s"; return; } ;;
      mise:*)   [[ -n ${in_mise[${s#mise:}]:-} ]] && { echo "$s"; return; } ;;
    esac
  done
  return 1
}
installed() {
  case $1 in
    pacman:*|aur:*) local n=${1#*:}; n=${n%%+*}; [[ -n ${in_system[${n#*/}]:-} ]] ;;
    mise:*) [[ -n ${in_tools[${1#mise:}]:-} ]] ;;
  esac
}

case ${1:-} in
  "") for f in "$DIR"/*.list; do basename "$f" .list; done ;;
  info)
    src=${2##*$'\t'}
    case $src in
      pacman:*) n=${src#pacman:}; pacman -Sii ${n//+/ } ;;
      aur:*)    amadeus-aur info "${src#aur:}" ;;
      mise:*)   amadeus-harness info "${src#mise:}" ;;
    esac ;;
  install)
    shift; repo=() aur=() tools=()
    for line in "$@"; do
      src=${line##*$'\t'}
      case $src in
        pacman:*) n=${src#pacman:}; read -ra parts <<<"${n//+/ }"; repo+=("${parts[@]}") ;;
        aur:*)    aur+=("${src#aur:}") ;;
        mise:*)   tools+=("${src#mise:}") ;;
      esac
    done
    (( ${#repo[@]} ))  && sudo pacman -S --needed -- "${repo[@]}"
    (( ${#aur[@]} ))   && amadeus-aur install "${aur[@]}"
    (( ${#tools[@]} )) && amadeus-harness install "${tools[@]}"
    exit 0 ;;
  *)
    [[ -f $DIR/$1.list ]] || { echo "No category called $1. Categories: $("$0" | paste -sd' ')"; exit 1; }
    load "$DIR/$1.list"
    grep -v '^#' "$DIR/$1.list" | while IFS=$'\t' read -r title sources; do
      src=$(resolve "$sources") || continue
      # Say when the choice comes from a user recipe; the label is what the picker shows.
      [[ $src == aur:* ]] && title+="  (AUR)"
      installed "$src" && title+="  (installed)"
      printf '%s\t%s\n' "$title" "$src"
    done ;;
esac
