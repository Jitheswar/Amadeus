#!/bin/bash

# amadeus:summary=Launch a floating terminal with the Amadeus presentation wrapper
# amadeus:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source amadeus-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="amadeus-show-logo; $cmd; code=\$?; if (( code != 130 )); then amadeus-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.amadeus.terminal --title=Amadeus -e bash -c "$presentation_script"
