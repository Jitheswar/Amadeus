#!/bin/bash
# Lists the Amadeus menu builds when an entry is opened: amadeus-menu-providers NAME [ARGS...]
# Named by "provider" (or "guard") in the menu definition. Exit status 1 means nothing was chosen.
pick()   { amadeus-pick "$@"; }
term()   { amadeus-terminal --title "Amadeus: $1" -e bash -c "$2; echo; read -rsn1 -p 'Press any key to close.'"; }
quoted() { local out; out=$(xargs -d '\n' printf '%q ' <<<"$1"); printf '%s' "$out"; }
say()    { notify-send -a Amadeus "$@"; }

# One category of the install catalogue: pick, then install in a terminal.
catalog() {
  local chosen; chosen=$(amadeus-catalog "$1" | pick --multi --preview 'amadeus-catalog info "$1"' "Install $2") || exit 0
  [[ -n $chosen ]] && term "install" "amadeus-catalog install $(quoted "$chosen")"
}

# Everything under Install reads pacman's package lists. Without them the menu would only ever
# say "Nothing matches", so fetch them first and say what happened.
lists_ready() {
  pacman -Slq core >/dev/null 2>&1 && return 0
  term "package lists" "sudo pacman -Sy && echo 'Package lists are ready. Open Install again.'"
  return 1
}

install_harness() {
  # AI coding harnesses, installed for this user through mise. The last line opens everything mise offers.
  local pkgs
  pkgs=$( { amadeus-harness list; printf 'More tools…\tmore\n'; } | pick --multi --preview 'amadeus-harness info "$1"' "Install harness") || exit 0
  if grep -q $'\tmore$' <<<"$pkgs"; then
    pkgs=$(amadeus-harness tools | pick --multi --preview 'amadeus-harness info "$1"' "Install tool") || exit 0
  fi
  [[ -n $pkgs ]] && term "install harness" "amadeus-harness install $(quoted "$(cut -f2 <<<"$pkgs" | grep -vx more)")"
}

install_webapp() {
  local name url
  name=$(pick --new "Web app name" </dev/null); (( $? == 2 )) || exit 0
  url=$(pick --new "Address of $name" </dev/null); (( $? == 2 )) || exit 0
  say "$(amadeus-webapp install "$name" "$url")"
}

install_packages() {
  local pkgs; pkgs=$(pacman -Slq | sort -u | pick --multi --preview 'pacman -Sii "$1"' "Install package") || exit 0
  [[ -n $pkgs ]] && term "install" "sudo pacman -S --needed -- $(quoted "$pkgs")"
}

install_aur() {
  # User-written recipes: the details pane shows who maintains each, Alt+B shows the recipe itself.
  local pkgs; pkgs=$(amadeus-aur list | pick --multi --preview 'amadeus-aur info "$1"' --preview2 'amadeus-aur recipe "$1"' --hint recipe "Install from AUR") || exit 0
  [[ -n $pkgs ]] && term "install from AUR" "amadeus-aur install $(quoted "$pkgs")"
}

remove_packages() {
  # Only what was installed on purpose is offered; dependencies go with it.
  local pkgs; pkgs=$(pacman -Qqe | pick --multi --preview 'pacman -Qi "$1"' "Remove package") || exit 0
  [[ -n $pkgs ]] && term "remove" "sudo pacman -Rns -- $(quoted "$pkgs")"
}

remove_harness() {
  local pkgs; pkgs=$(amadeus-harness installed | pick --multi --preview 'amadeus-harness info "$1"' "Remove harness or tool") || exit 0
  [[ -n $pkgs ]] && term "remove" "amadeus-harness remove $(quoted "$pkgs")"
}

remove_webapp() {
  local pkgs; pkgs=$(amadeus-webapp list | pick --multi "Remove web app") || exit 0
  [[ -n $pkgs ]] && say "$(xargs -d '\n' amadeus-webapp remove <<<"$pkgs")"
}

text_size() {
  local s; s=$(printf '%s\n' 12 14 16 18 20 | pick "Text size (now $(amadeus-display text))") || exit 0
  say "$(amadeus-display text "$s")"
}

# Kind of file or link -> the types that decide which application opens it.
declare -A KINDS=(
  [Browser]="x-scheme-handler/https x-scheme-handler/http text/html"
  [Files]="inode/directory"
  [Images]="image/png image/jpeg image/webp image/gif"
  [Video]="video/mp4 video/x-matroska video/webm"
  [Music]="audio/mpeg audio/flac audio/ogg"
  [Documents]="application/pdf"
  [Mail]="x-scheme-handler/mailto"
)

default_choices() { printf '%s\n' Terminal Editor Harness Agent Browser Files Images Video Music Documents Mail; }

defaults_menu() {
  local kind=${1:-$(default_choices | pick --global "Default")}
  [[ -n $kind ]] || exit 0
  case $kind in
    Agent) exec ama panel settings ;;
    Terminal|Editor|Harness)
      local what=${kind,,} now choice
      now=$(amadeus-default "$what")
      choice=$(amadeus-default "$what" --choices | pick "Default $what${now:+ (now $now)}") || exit 0
      [[ -n $choice ]] && say "$(amadeus-default "$what" "$choice")" "Was: ${now:-not set}"
      exit 0 ;;
  esac
  local types=${KINDS[$kind]} first; [[ -n $types ]] || exit 0
  first=${types%% *}
  local -A byname=(); local f name
  for f in /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop; do
    [[ -f $f ]] && grep -qE "^MimeType=.*(^|;|=)${first//\//\\/}(;|$)" "$f" || continue
    grep -q '^NoDisplay=true' "$f" && continue
    name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    byname[${name:-$(basename "$f" .desktop)}]=$(basename "$f")
  done
  (( ${#byname[@]} )) || { say "No application for $kind is installed"; exit 0; }
  local current; current=$(xdg-mime query default "$first")
  local choice; choice=$(printf '%s\n' "${!byname[@]}" | sort | pick "$kind opens with") || exit 0
  [[ -n ${byname[$choice]:-} ]] || exit 0
  # shellcheck disable=SC2086
  xdg-mime default "${byname[$choice]}" $types
  [[ $kind == Browser ]] && xdg-settings set default-web-browser "${byname[$choice]}" 2>/dev/null
  say "$kind now opens with $choice" "Was: ${current:-not set}"
}

# Every file a user is meant to edit, found by looking: what exists is offered.
config_choices() {
  local c=${XDG_CONFIG_HOME:-$HOME/.config} f
  for f in "Desktop and shortcuts:$c/hypr/hyprland.lua" "Display:$c/hypr/display.lua" "Added by Amadeus:$c/hypr/amadeus.lua" \
           "Bar layout:$c/amadeus/bar.json" "Look and motion:$c/amadeus/theme.json" "Defaults:$c/amadeus/defaults" \
           "AI providers and permissions:$c/amadeus/config.toml" "Terminal (foot):$c/foot/foot.ini" "Lock screen:$c/swaylock/config" \
           "Idle and sleep:$c/swayidle/config" "About screen:$c/fastfetch/config.jsonc" "Default applications:$c/mimeapps.list" \
           "Shell (bash):$HOME/.bashrc" "System look, shipped (read only):/usr/share/amadeus-os/theme.json"; do
    [[ -e ${f#*:} || ${f%%:*} == "Look and motion" ]] && printf '%s\t%s\n' "${f%%:*}" "${f#*:}"
  done
}

config_menu() {
  local choice="" label path
  if [[ -n ${1:-} ]]; then
    while IFS=$'\t' read -r label path; do
      [[ $label == "$1" ]] && choice=$label$'\t'$path
    done < <(config_choices)
  else
    choice=$(config_choices | pick --preview 'head -c 6000 "${1##*	}" 2>/dev/null || echo "Not created yet. Choosing it starts a new file."' "Edit") || exit 0
  fi
  [[ -n $choice ]] && exec amadeus-editor "${choice##*$'\t'}"
}

gpu_menu() {
  local now; now=$(amadeus-gpu)
  [[ $now == one ]] && { say "One graphics processor" "This computer has only one, so there is nothing to choose."; exit 0; }
  local mark; mark() { [[ $now == "$1" ]] && printf '  (in use)'; }
  local choice; choice=$(printf '%s\n' \
    "Automatic: integrated for the desktop, dedicated for games$(mark auto)"$'\t'auto \
    "Dedicated for everything: most performance, most power$(mark dedicated)"$'\t'dedicated \
    "Integrated only: the dedicated GPU sleeps, longest battery$(mark integrated)"$'\t'integrated | pick "Graphics") || exit 0
  local new=${choice##*$'\t'}
  [[ $new == "$now" ]] && exit 0
  amadeus-gpu set "$new" >/dev/null
  case $(printf 'Log out now\nLater' | pick "Takes effect at the next login") in
    "Log out now") uwsm stop ;;
    *) say "Graphics changes at the next login" ;;
  esac
}

case ${1:-} in
  catalog) catalog "$2" "$3" ;;
  lists-ready) lists_ready ;;
  install-harness) install_harness ;;
  install-webapp) install_webapp ;;
  install-packages) install_packages ;;
  install-aur) install_aur ;;
  remove-packages) remove_packages ;;
  remove-harness) remove_harness ;;
  remove-webapp) remove_webapp ;;
  text-size) text_size ;;
  defaults) defaults_menu "${2:-}" ;;
  config) config_menu "${2:-}" ;;
  gpu) gpu_menu ;;
  settings-index)
    while read -r kind; do printf 'default:%s\t%s\t%s\n' "$kind" "$kind" "${KINDS[$kind]:-$kind}"; done < <(default_choices)
    while IFS=$'\t' read -r label path; do printf 'config:%s\t%s\t%s\n' "$label" "$label" "$path"; done < <(config_choices) ;;
  default-types)
    for kind in "${!KINDS[@]}"; do printf '%s\t%s\n' "${kind,,}" "${KINDS[$kind]}"; done ;;
  *) sed -n 2,3p "$0"; exit 1 ;;
esac
