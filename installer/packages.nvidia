# NVIDIA RTX 3050 6GB Laptop (GA107BM, 10de:25ec); installed only when an NVIDIA GPU is present.
# nvidia-open is prebuilt for the `linux` kernel and updates in step with it. The GPU firmware
# ships inside nvidia-utils, so linux-firmware-nvidia (for the nouveau/nova drivers) is not needed.
nvidia-open nvidia-utils lib32-nvidia-utils libva-nvidia-driver
