#!/bin/bash

# amadeus:summary=Remove the GeForce NOW Flatpak app and its data.
# amadeus:group=remove
# amadeus:name=gaming geforce-now

set -e

if amadeus-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
