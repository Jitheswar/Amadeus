pkgname=amadeus-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Amadeus OS desktop: Hyprland defaults, shell (bar, picker, notifications), system tools and user skeleton"
arch=(any)
license=(MIT)
depends=(hyprland uwsm quickshell foot swaylock swayidle polkit-gnome grim slurp hyprpicker satty gpu-screen-recorder ffmpeg wl-clipboard cliphist wtype fastfetch brightnessctl networkmanager wireplumber upower power-profiles-daemon bluez polkit xdg-utils libnotify inter-font ttf-jetbrains-mono dconf mise)
options=(!debug)
install=amadeus-desktop.install

package() {
  local src="$startdir"
  install -Dm644 "$src/hypr/default.lua" -t "$pkgdir/usr/share/amadeus-os/hypr/"
  install -Dm644 "$src"/shell/*.qml -t "$pkgdir/usr/share/amadeus-os/shell/"
  install -Dm755 "$src"/bin/* -t "$pkgdir/usr/bin/"
  # Passwordless administrator access is a switch the user turns on from the bar; this is its root side.
  install -Dm755 "$src/lib/sudo-helper" -t "$pkgdir/usr/lib/amadeus-os/"
  install -Dm644 "$src/lib/org.amadeus.sudo.policy" -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 "$src/lib/amadeus-sudo-boot.service" -t "$pkgdir/usr/lib/systemd/system/"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../amadeus-sudo-boot.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
  install -Dm644 "$src/theme/theme.json" "$src/harnesses.list" -t "$pkgdir/usr/share/amadeus-os/"
  install -Dm644 "$src"/catalog/*.list -t "$pkgdir/usr/share/amadeus-os/catalog/"
  install -Dm644 "$src/theme/fastfetch.jsonc" "$pkgdir/etc/skel/.config/fastfetch/config.jsonc"
  # Programs installed through mise are on everyone's PATH, and EDITOR follows the chosen default.
  install -Dm644 /dev/stdin "$pkgdir/etc/profile.d/amadeus.sh" <<'P'
export PATH="$HOME/.local/share/mise/shims:$PATH"
export EDITOR=amadeus-editor VISUAL=amadeus-editor
P
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/amadeus-editor.desktop" <<'D'
[Desktop Entry]
Type=Application
Name=Text Editor
Comment=Opens files in your default editor
Exec=amadeus-editor %F
Icon=accessories-text-editor
MimeType=text/plain;text/markdown;text/x-shellscript;application/json;application/toml;application/x-yaml;
NoDisplay=true
D
  install -Dm644 /dev/stdin "$pkgdir/etc/skel/.config/mimeapps.list" <<'M'
[Default Applications]
text/plain=amadeus-editor.desktop
text/markdown=amadeus-editor.desktop
M
  printf 'TERMINAL=foot\nEDITOR=nano\nHARNESS=claude\n' | install -Dm644 /dev/stdin "$pkgdir/etc/skel/.config/amadeus/defaults"
  # Other applications follow the same look: dark, the accent colour, the same fonts.
  install -Dm644 "$src/theme/dconf-profile" "$pkgdir/etc/dconf/profile/user"
  install -Dm644 "$src/theme/dconf-defaults" "$pkgdir/etc/dconf/db/local.d/00-amadeus"
  install -Dm644 "$src/theme/fonts.conf" "$pkgdir/etc/fonts/conf.d/60-amadeus.conf"
  cp -r "$src/skel" "$pkgdir/etc-skel" && install -d "$pkgdir/etc" && mv "$pkgdir/etc-skel" "$pkgdir/etc/skel"
  install -Dm644 "$src/shell/bar.default.json" "$pkgdir/etc/skel/.config/amadeus/bar.json"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/os-release.amadeus" <<'OS'
NAME="Amadeus OS"
PRETTY_NAME="Amadeus OS"
ID=amadeus
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;139;203;177"
AMADEUS_LINE="El Psy Kongroo"
OS
  # Keep the system identifying as Amadeus OS when Arch updates its own os-release.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/amadeus-os-release.hook" <<'HOOK'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = amadeus-desktop
[Action]
Description = Setting the system identity to Amadeus OS
When = PostTransaction
Exec = /usr/bin/ln -sf ../usr/lib/os-release.amadeus /etc/os-release
HOOK
}
