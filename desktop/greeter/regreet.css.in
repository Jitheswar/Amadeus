/* Generated from the desktop palette; keep authentication in greetd/ReGreet. */
@define-color bg @bg@;
@define-color surface @surface@;
@define-color raised @raised@;
@define-color line @line@;
@define-color fg @fg@;
@define-color dim @dim@;
@define-color accent @accent@;
@define-color bad @bad@;
* { font-family: "@font@"; font-size: 15px; }
window {
  background-color: @bg;
  background-image: url("file://@dir@/background.png");
  background-position: center;
  background-size: cover;
  color: @fg;
}
frame.background {
  background: @surface;
  border: 1px solid @line;
  border-radius: 24px;
  padding: 28px 32px;
  box-shadow: 0 18px 70px alpha(black, 0.32);
  animation: arrive @slow@ms ease-out;
}
frame.background > grid > label:first-child {
  font-size: 22px;
  color: @fg;
  margin-bottom: 18px;
}
label { color: @dim; }
entry, passwordentry, combobox > box > button {
  min-height: 36px;
  padding: 6px 14px;
  background: @bg;
  color: @fg;
  border: 1px solid @line;
  border-radius: @radius@px;
  box-shadow: none;
  transition: border-color @normal@ms ease-out, background-color @normal@ms ease-out;
}
entry:focus-within, passwordentry:focus-within { border-color: @accent; }
entry text, passwordentry text { color: @fg; background: transparent; }
button {
  min-height: 32px;
  padding: 7px 18px;
  border-radius: @radius@px;
  border: 1px solid @line;
  background: @raised;
  color: @fg;
  box-shadow: none;
  transition: background-color @fast@ms ease-out, border-color @fast@ms ease-out;
}
button label { color: inherit; }
button:hover { background: mix(@raised, @accent, 0.12); border-color: alpha(@accent, 0.5); }
button:focus-visible { outline: 2px solid @accent; outline-offset: 3px; }
button.suggested-action { background: @accent; color: @bg; border-color: @accent; font-weight: 600; }
button.suggested-action:hover { background: shade(@accent, 1.1); }
button:disabled { opacity: 0.45; }
button.destructive-action { background: alpha(@surface, 0.8); color: @dim; border-color: @line; }
button.destructive-action:hover { color: @fg; border-color: @accent; }
frame.background + frame.background { background: transparent; border: none; box-shadow: none; margin-top: 42px; padding: 12px 22px; }
frame.background + frame.background label { color: @dim; font-family: "@mono@"; font-size: 17px; }
popover contents { background: @surface; color: @fg; border: 1px solid @line; border-radius: @radius@px; }
popover modelbutton:hover { background: @raised; }
infobar { border-radius: @radius@px; background: @raised; color: @fg; }
@keyframes arrive { from { opacity: 0; } to { opacity: 1; } }
