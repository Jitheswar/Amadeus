#!/bin/bash

# amadeus:summary=Install and start the Dropbox service. Must then be authenticated via the web.
# amadeus:requires-sudo=true

echo "Installing all dependencies..."
amadeus-pkg-add dropbox dropbox-cli libappindicator python-gpgme

echo "Adding Dropbox to the bar..."
amadeus-plugin-enable amadeus.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
