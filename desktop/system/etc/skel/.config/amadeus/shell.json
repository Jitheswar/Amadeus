{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "amadeus.menu"
        },
        {
          "id": "amadeus.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "amadeus.indicators"
        }
      ],
      "center": [
        {
          "id": "amadeus.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "amadeus.elsewhen"
        },
        {
          "id": "amadeus.weather"
        },
        {
          "id": "amadeus.system-update"
        }
      ],
      "right": [
        {
          "id": "amadeus.tray"
        },
        {
          "id": "amadeus.keyboard-layout"
        },
        {
          "id": "amadeus.agents"
        },
        {
          "id": "amadeus.bluetooth"
        },
        {
          "id": "amadeus.network"
        },
        {
          "id": "amadeus.audio"
        },
        {
          "id": "amadeus.monitor"
        },
        {
          "id": "amadeus.assistant"
        },
        {
          "id": "amadeus.power"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "folio",
      "amadeus-browser",
      "amadeus-terminal",
      "omacalc",
      "omawrite",
      "hype",
      "monologue",
      "cliamp"
    ]
  },
  "plugins": []
}
