#!/bin/bash

# amadeus:summary=Launch the default coding agent with a prompt
# amadeus:args=[--inline] <prompt...>
# amadeus:examples=amadeus agent prompt "Review this project"

# Prompts live here rather than on `amadeus agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if [[ -z $* ]]; then
  echo "Usage: amadeus agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec amadeus-agent "${inline[@]}" --prompt "$*"
