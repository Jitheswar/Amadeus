#!/bin/bash

# amadeus:summary=Send the low battery warning notification and run battery-low hooks.
# amadeus:args=<percentage>
# amadeus:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: amadeus-battery-low <percentage>" >&2
  exit 1
fi

level=$1

amadeus-notification-send -g 󱐋 -u normal "$(amadeus-i18n battery.lowTitle)" "$(amadeus-i18n battery.lowBody "$level")" -i battery-caution -t 30000
amadeus-hook battery-low "$level"
