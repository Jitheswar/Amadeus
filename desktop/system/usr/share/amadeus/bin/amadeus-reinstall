#!/bin/bash

# amadeus:summary=Reinstall Amadeus packages and reset default configs
# amadeus:requires-sudo=true

set -e

echo -e "This will reinstall all default Amadeus packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  amadeus-reinstall-pkgs
  amadeus-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && amadeus-system reboot
fi
