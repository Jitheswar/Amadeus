#!/bin/bash
# Power menu (Super+Escape): lock, suspend, log out, restart, shut down.
choice=$(printf 'Lock\nSuspend\nLog out\nRestart\nShut down' | amadeus-pick Power) || exit 0
case $choice in
  Lock) swaylock -f ;;
  Suspend) systemctl suspend ;;
  "Log out") niri msg action quit --skip-confirmation ;;
  Restart) systemctl reboot ;;
  "Shut down") systemctl poweroff ;;
esac
