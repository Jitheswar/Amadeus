#!/usr/bin/python3
# Application launcher: pick an installed application and start it; text that matches nothing goes to Amadeus.
"""Applications are read from the desktop entries installed now. Games and applications
that ask for the dedicated GPU are started on the NVIDIA card; everything else on Intel."""
import os, re, shlex, shutil, subprocess, sys
from pathlib import Path

DIRS = [Path.home() / ".local/share/applications", Path("/usr/local/share/applications"), Path("/usr/share/applications")]
NVIDIA = {"__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia", "__VK_LAYER_NV_optimus": "NVIDIA_only"}


def entries():
    out = {}
    for d in reversed(DIRS):
        for f in sorted(d.glob("*.desktop")):
            e, section = {}, None
            for line in f.read_text(errors="replace").splitlines():
                if line.startswith("["):
                    section = line
                elif section == "[Desktop Entry]" and "=" in line:
                    k, v = line.split("=", 1)
                    e[k] = v
            if (e.get("Exec") and e.get("NoDisplay") != "true" and e.get("Hidden") != "true"
                    and e.get("Type", "Application") == "Application"
                    and (not e.get("TryExec") or shutil.which(e["TryExec"]))):
                out[f.stem] = e
    return out


def has_nvidia():
    for p in Path("/sys/bus/pci/devices").glob("*/vendor"):
        try:
            if p.read_text().strip() == "0x10de":
                return True
        except OSError:
            pass
    return False


def start(e):
    argv = [t for t in shlex.split(e["Exec"]) if not re.fullmatch(r"%[a-zA-Z]", t)]
    if e.get("Terminal") == "true":
        argv = ["amadeus-terminal", "-e"] + argv
    dedicated = e.get("PrefersNonDefaultGPU") == "true" or e.get("X-KDE-RunOnDiscreteGpu") == "true" or "Game" in e.get("Categories", "").split(";")
    mode_file = Path.home() / ".config/amadeus/gpu"
    try:
        mode = mode_file.read_text().strip()
    except OSError:
        mode = "auto"
    # In "nvidia" mode the whole session already runs on NVIDIA; in "intel" mode nothing is sent to it.
    env = dict(os.environ, **NVIDIA) if dedicated and has_nvidia() and mode == "auto" else None
    cwd = Path(e.get("Path") or Path.home())
    if not cwd.is_dir():
        cwd = Path.home()
    try:
        subprocess.Popen(argv, env=env, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        # A removed application must not take the launcher down with it.
        reason = f"{argv[0]} was not found." if isinstance(error, FileNotFoundError) else str(error)
        subprocess.run(["notify-send", "-a", "Amadeus", f"Could not open {e.get('Name', e['Exec'])}", reason], check=False)


def main():
    apps = entries()
    lines = sorted((f"{e.get('Name', i)}\t{i}" for i, e in apps.items()), key=str.lower)
    if "--print" in sys.argv:
        return print("\n".join(lines))
    p = subprocess.run(["amadeus-pick", "--new", "--new-label", "Press Enter to ask Amadeus", "Apps"], input="\n".join(lines), capture_output=True, text=True)
    choice = p.stdout.strip()
    if p.returncode == 0 and "\t" in choice:
        start(apps[choice.split("\t")[1]])
    elif p.returncode == 2 and choice:
        subprocess.run(["ama", "panel", "ask", choice])


main()
