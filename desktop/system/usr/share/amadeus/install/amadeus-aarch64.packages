# Additions for every aarch64 platform, composed after amadeus-base.packages
# (amadeus-pkg-defaults). amadeus-desktop configures swap on zram, and the
# x86_64 installer provides zram-generator for it; aarch64 gets it here.
zram-generator
# The x86_64 ISO installs these from amadeus-other.packages; ARM has no ISO.
# pipewire-jack is the jack provider x86_64 gets, and
# gst-plugin-pipewire gives GStreamer apps PipeWire capture and playback.
pipewire-jack
gst-plugin-pipewire
