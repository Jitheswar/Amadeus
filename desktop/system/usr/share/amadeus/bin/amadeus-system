#!/bin/bash

# amadeus:summary=Log out, reboot, reboot to the BIOS, or shut down after closing applications
# amadeus:args=<logout|reboot|firmware|shutdown>
# amadeus:examples=amadeus system logout | amadeus system reboot | amadeus system firmware | amadeus system shutdown
# amadeus:aliases=amadeus logout | amadeus reboot | amadeus shutdown

usage="Usage: amadeus-system <logout|reboot|firmware|shutdown>"
for arg in "$@"; do
  case $arg in
    -h | --help) echo "$usage"; exit 0 ;;
  esac
done
if (( $# > 2 )); then
  echo "$usage" >&2
  exit 2
fi

action=${1:-}
case $action in
  logout) command=(uwsm stop) ;;
  reboot) command=(systemctl reboot --no-wall) ;;
  firmware) command=(systemctl reboot --firmware-setup --no-wall) ;;
  shutdown) command=(systemctl poweroff --no-wall) ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

# Each action has whole sentences of its own, so a translation can inflect it.
case $action in
  logout)
    message=$(amadeus-i18n system.loggingOut)
    failed_title=$(amadeus-i18n system.logoutFailed)
    failed_body=$(amadeus-i18n system.logoutRetry)
    ;;
  reboot)
    message=$(amadeus-i18n system.rebooting)
    failed_title=$(amadeus-i18n system.rebootFailed)
    failed_body=$(amadeus-i18n system.rebootRetry)
    ;;
  firmware)
    message=$(amadeus-i18n system.rebootingToFirmware)
    failed_title=$(amadeus-i18n system.firmwareFailed)
    failed_body=$(amadeus-i18n system.firmwareRetry)
    ;;
  shutdown)
    message=$(amadeus-i18n system.shuttingDown)
    failed_title=$(amadeus-i18n system.shutdownFailed)
    failed_body=$(amadeus-i18n system.shutdownRetry)
    ;;
esac

exit_session() {
  # systemctl only finds out the firmware can't do it after the apps are gone.
  if [[ $action == "firmware" ]]; then
    local answer
    answer=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanRebootToFirmwareSetup 2>/dev/null)
    if [[ $answer != 's "yes"' ]]; then
      return 1
    fi
  fi

  # Only show the OSD once the exit has taken 2 seconds, so a quick one doesn't flash it.
  { sleep 2; amadeus-osd -i "${action/firmware/reboot}" -m "$message" -d 0; } &
  local osd_pid=$!

  if [[ $action != "logout" ]]; then
    amadeus-state clear re*-required
  fi

  # Proceed as soon as apps exit, with a bound for unresponsive windows.
  timeout 2s amadeus-hyprland-window-close-all --wait
  if "${command[@]}"; then
    # The unit kills the delayed OSD when this script exits, so stay until the session goes down.
    wait "$osd_pid"
  else
    local status=$?
    kill "$osd_pid" 2>/dev/null
    amadeus-shell -q osd close
    return "$status"
  fi
}

if [[ ${2:-} == "--inhibited" ]]; then
  exit_session
elif [[ ${2:-} == "--execute" ]]; then
  if [[ $action == "shutdown" ]]; then
    # Block lid handling explicitly: it ignores high-level sleep inhibitors.
    systemd-inhibit --what=sleep:idle:handle-lid-switch \
      --who=Amadeus --why="Shutdown in progress" --mode=block \
      "$0" "$action" --inhibited
  else
    exit_session
  fi
  status=$?
  if (( status != 0 )); then
    amadeus-notification-send -u critical "$failed_title" "$failed_body"
    exit "$status"
  fi
elif [[ -z ${2:-} ]]; then
  # Survive closing the terminal that requested the session exit.
  systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
    --setenv=PATH --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=AMADEUS_PATH \
    "$0" "$action" --execute
else
  echo "$usage" >&2
  exit 2
fi
