pkgname=amadeus-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Amadeus OS desktop: the desktop system (shell, Hyprland modules, themes, commands), hardware support and user skeleton"
arch=(any)
license=(MIT)
depends=(python-gobject sddm plymouth limine limine-mkinitcpio-hook librsvg hyprland uwsm quickshell foot grim slurp hyprpicker gpu-screen-recorder ffmpeg wl-clipboard wtype fastfetch brightnessctl networkmanager wireplumber upower power-profiles-daemon bluez polkit xdg-utils libnotify inter-font ttf-jetbrains-mono dconf mise)
options=(!debug)
install=amadeus-desktop.install
# System configuration under /etc is the administrator's to change: an update keeps local edits.
backup=($(cd "$startdir/system" && find etc -path etc/skel -prune -o -type f -print))

package() {
  local src="$startdir"
  install -Dm644 "$src"/hardware/* -t "$pkgdir/usr/share/amadeus-os/hardware/"
  install -Dm644 "$src/OMARCHY-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/OMARCHY-LICENSE"
  install -Dm644 "$src/launcher.hides" -t "$pkgdir/usr/share/amadeus-os/"
  install -Dm644 "$src"/migrations/*.sh -t "$pkgdir/usr/share/amadeus-os/migrations/"
  install -d "$pkgdir/usr/bin"
  # Only files: a test run can leave a __pycache__ directory beside the programs.
  find "$src/bin" -maxdepth 1 -type f -exec install -Dm755 {} -t "$pkgdir/usr/bin/" \;
  # The desktop system: its commands, shell, defaults, themes, and system and user configuration,
  # laid out as it lands on disk. Its commands are reached from /usr/bin.
  cp -R --preserve=mode,links "$src/system/." "$pkgdir/"
  chmod 750 "$pkgdir/etc/sudoers.d"
  chmod 440 "$pkgdir"/etc/sudoers.d/*
  local f
  for f in "$pkgdir"/usr/share/amadeus/bin/*; do
    ln -sfn "/usr/share/amadeus/bin/${f##*/}" "$pkgdir/usr/bin/${f##*/}"
  done
  install -Dm755 "$src/lib/amadeus-file-context" "$pkgdir/usr/share/amadeus-os/nautilus/Ask Amadeus"
  install -d "$pkgdir/etc/skel/.local/share/nautilus/scripts"
  ln -s "/usr/share/amadeus-os/nautilus/Ask Amadeus" "$pkgdir/etc/skel/.local/share/nautilus/scripts/Ask Amadeus"
  # Stable names for the two graphics cards, for Setup > GPU (their numbers can change between boots):
  # the one the firmware starts the screen on, and the other, whatever their makers.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/70-amadeus-gpu.rules" <<'U'
KERNEL=="card*", SUBSYSTEM=="drm", ATTRS{boot_vga}=="1", SYMLINK+="dri/igpu-card"
KERNEL=="card*", SUBSYSTEM=="drm", ATTRS{boot_vga}=="0", SYMLINK+="dri/dgpu-card"
U
  install -Dm644 "$src/theme/theme.json" "$src/harnesses.list" -t "$pkgdir/usr/share/amadeus-os/"
  install -Dm644 "$src"/catalog/*.list -t "$pkgdir/usr/share/amadeus-os/catalog/"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/os-release.amadeus" <<'OS'
NAME="Amadeus OS"
PRETTY_NAME="Amadeus OS"
ID=amadeus
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;139;203;177"
AMADEUS_LINE="El Psy Kongroo"
OS
  # Keep the system identifying as Amadeus OS when Arch updates its own os-release.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/amadeus-os-release.hook" <<'HOOK'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = amadeus-desktop
[Action]
Description = Setting the system identity to Amadeus OS
When = PostTransaction
Exec = /usr/bin/ln -sf ../usr/lib/os-release.amadeus /etc/os-release
HOOK
}
