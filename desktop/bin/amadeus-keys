#!/usr/bin/python3
# Keyboard shortcuts and system commands (Super+K): a searchable list read from the live configuration.
"""Nothing here is a stored list. Shortcuts are asked from the running desktop (so the ones
you or Amadeus added appear at once), or read from a configuration file when no desktop is
running; commands are the amadeus-* programs installed, each with its own description.
  amadeus-keys            show the list in a searchable menu
  amadeus-keys --print    print it"""
import json, os, re, subprocess, sys
from pathlib import Path

CONFIG = os.environ.get("AMADEUS_HYPR_CONFIG")
MASKS = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift")]
KEYS = {"RETURN": "Enter", "Return": "Enter", "SPACE": "Space", "ESCAPE": "Escape", "PRINT": "Print Screen", "Print": "Print Screen",
        "XF86AudioRaiseVolume": "Volume up", "XF86AudioLowerVolume": "Volume down", "XF86AudioMute": "Mute",
        "XF86AudioMicMute": "Mute microphone", "XF86MonBrightnessUp": "Brightness up", "XF86MonBrightnessDown": "Brightness down",
        "XF86AudioPlay": "Play / pause", "XF86AudioNext": "Next track", "XF86AudioPrev": "Previous track",
        "mouse:272": "Left drag", "mouse:273": "Right drag", "LEFT": "Left", "RIGHT": "Right", "UP": "Up", "DOWN": "Down"}


def pretty(mods, key):
    return " + ".join(mods + [KEYS.get(key, key.upper() if len(key) == 1 else key)])


def live():
    p = subprocess.run(["hyprctl", "-j", "binds"], capture_output=True, text=True)
    if p.returncode:
        return None
    try:
        binds = json.loads(p.stdout)
    except json.JSONDecodeError:
        return None
    return [(pretty([n for bit, n in MASKS if b["modmask"] & bit], b["key"]), b["description"]) for b in binds if b.get("description")]


def from_file(path):
    """o.bind("KEYS", "Description", ...) lines, following dofile()."""
    out, seen = {}, set()
    def read(p):
        p = Path(p).resolve()
        if p in seen or not p.is_file():
            return
        seen.add(p)
        for line in p.read_text(errors="replace").splitlines():
            m = re.search(r'dofile\("([^"]+)"\)', line)
            if m:
                target = Path(m.group(1)).expanduser()
                read(target if target.is_absolute() else p.parent / target)
            m = re.match(r'\s*o\.bind\("([^"]+)",\s*"([^"]*)"', line)
            if m:
                parts = [x.strip() for x in m.group(1).split("+")]
                out[m.group(1)] = (pretty([x.capitalize() for x in parts[:-1]], parts[-1]), m.group(2))
    read(path)
    return list(out.values())


def commands():
    out = []
    for f in sorted(Path("/usr/bin").glob("amadeus-*")) + [Path("/usr/bin/ama")]:
        try:
            second = f.read_text(errors="replace").splitlines()[1]
        except (OSError, IndexError):
            continue
        if second.startswith("#"):
            out.append((f.name, second.lstrip("# ").split(":")[0].split(". ")[0].rstrip(".")))
    return out


def main():
    rows = from_file(CONFIG) if CONFIG else (live() or from_file(Path.home() / ".config/hypr/hyprland.lua"))
    cmds = commands()
    width = max([len(k) for k, _ in rows] + [len(c) for c, _ in cmds] + [10])
    lines = [f"{k:<{width}}   {v}" for k, v in rows] + [f"{c:<{width}}   {d}  (command)" for c, d in cmds]
    if "--print" in sys.argv:
        return print("\n".join(lines))
    subprocess.run(["amadeus-pick", "Shortcuts and commands"], input="\n".join(lines), text=True, capture_output=True)


main()
