#!/bin/bash

# amadeus:summary=Apply Amadeus hardware-specific packages and system configuration
# amadeus:group=apply
# amadeus:requires-sudo=true
# amadeus:examples=amadeus apply hardware --install-user dhh
# amadeus:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: amadeus apply hardware --install-user USER
       amadeus apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by amadeus-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/amadeus/provisioning/groups.

In an image build (/var/lib/amadeus/image/target exists) nothing runs here: every step is queued
for amadeus-provision-hardware on the machine's first boot.
USAGE
}

install_user="${AMADEUS_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: amadeus-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export AMADEUS_INSTALL_USER="$install_user"
# Only amadeus-provision-hardware runs steps as an image's first boot.
unset AMADEUS_IMAGE_DEFERRED_HARDWARE
export AMADEUS_PATH="${AMADEUS_PATH:-/usr/share/amadeus}"
export AMADEUS_INSTALL="${AMADEUS_INSTALL:-$AMADEUS_PATH/install}"
export AMADEUS_INSTALL_LOG_FILE="${AMADEUS_INSTALL_LOG_FILE:-/var/log/amadeus-install.log}"
export PATH="$AMADEUS_PATH/bin:$PATH"

source "$AMADEUS_INSTALL/helpers/logging.sh"
source "$AMADEUS_INSTALL/helpers/image-target.sh"

amadeus_image_init
amadeus_image_lock
if amadeus_image_manifest_present; then
  amadeus_image_read_manifest
  amadeus_image_defer_hardware
else
  source "$AMADEUS_INSTALL/hardware/all.sh"
fi
