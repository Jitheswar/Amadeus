#!/bin/bash

# amadeus:summary=Remove the Moonlight game streaming client along with its paired hosts and settings.
# amadeus:requires-sudo=true

set -e

amadeus-pkg-drop moonlight-qt

rm -rf \
  "$HOME/.config/Moonlight Game Streaming Project" \
  "$HOME/.cache/Moonlight Game Streaming Project"

echo ""
echo "Moonlight and its settings have been removed."
