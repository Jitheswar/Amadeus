#!/bin/bash

# amadeus:summary=Reinstall every default Amadeus package and the drivers this computer needs
# amadeus:requires-sudo=true

set -e

# Ensure this computer's default packages are installed (the installer's lists, shipped
# with the desktop package), then the drivers and fixes amadeus-hardware picks for it.
default_packages=$(amadeus-pkg-defaults)

# pipewire-jack conflicts with jack and jack2, and --ask 4 below would remove
# them for it, so a machine that kept either keeps it.
if amadeus-pkg-present jack2 || amadeus-pkg-present jack; then
  default_packages=$(grep -vx pipewire-jack <<<"$default_packages")
fi

mapfile -t packages <<<"$default_packages"

# --ask 4 accepts removing a stock package a default replaces.
amadeus-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
amadeus-hardware setup
