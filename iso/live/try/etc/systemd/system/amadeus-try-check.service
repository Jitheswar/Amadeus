[Unit]
Description=Amadeus OS: report on the try session (only with a test disk attached)
ConditionPathExists=/dev/disk/by-label/AMADEUSTRY
# This observer must not hold multi-user.target open while UWSM waits for graphical.target.
DefaultDependencies=no
After=graphical.target sddm.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/amadeus-try-check

[Install]
WantedBy=multi-user.target
