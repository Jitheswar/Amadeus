text = "{{ background }}"

[colors.normal]
black = "{{ surface }}"
red = "{{ red }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
blue = "{{ blue }}"
magenta = "{{ magenta }}"
cyan = "{{ cyan }}"
white = "{{ light_foreground }}"

[colors.bright]
