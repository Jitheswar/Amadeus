#!/bin/bash

# amadeus:summary=Print the active Amadeus package channel

set -euo pipefail

# Dev is a linked source checkout: AMADEUS_PATH points somewhere other than
# the package-backed install at /usr/share/amadeus. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $AMADEUS_PATH != "/usr/share/amadeus" ]]; then
  echo dev
  exit 0
fi

# amadeus-desktop / amadeus-desktop are only shipped from the edge package
# repo, so their presence alone means edge. amadeus / amadeus-desktop come
# from either the stable or rc mirror, distinguished by amadeus-version-channel
# (which reports the mirror as its first token).
if pacman -Q amadeus-desktop amadeus-desktop >/dev/null 2>&1; then
  echo edge
elif pacman -Q amadeus amadeus-desktop >/dev/null 2>&1; then
  channel=$(amadeus-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
