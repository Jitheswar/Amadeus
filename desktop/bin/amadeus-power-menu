#!/bin/bash
choice=$(printf 'Lock\nSuspend\nLog out\nRestart\nShut down' | fuzzel --dmenu --lines 5 --prompt 'Power  ') || exit 0
case $choice in
  Lock) swaylock -f ;;
  Suspend) systemctl suspend ;;
  "Log out") niri msg action quit --skip-confirmation ;;
  Restart) systemctl reboot ;;
  "Shut down") systemctl poweroff ;;
esac
