# Maintainer: local build
pkgname=amadeus
pkgver=0.1.0
pkgrel=1
pkgdesc="AI layer for the operating system: policy-controlled agent, sandboxed generated apps"
arch=(any)
license=(MIT)
depends=(python bubblewrap quickshell hyprland git polkit snapper systemd)
optdepends=('networkmanager: network tools' 'power-profiles-daemon: power profile control' 'cuda: GPU compute in sandboxes')
options=(!debug)

package() {
  local src="$startdir"
  install -d "$pkgdir/usr/share/amadeus-ai" "$pkgdir/usr/lib/amadeus" "$pkgdir/usr/bin" "$pkgdir/usr/share/doc/amadeus"
  cp -r "$src/amadeus" "$src/shell" "$src/examples" "$src/skill" "$pkgdir/usr/share/amadeus-ai/"
  # The built-in agent skill, where Claude Code looks for skills in every new user's home.
  install -d "$pkgdir/etc/skel/.claude/skills"
  ln -s /usr/share/amadeus-ai/skill/amadeus "$pkgdir/etc/skel/.claude/skills/amadeus"
  find "$pkgdir" -name __pycache__ -type d -exec rm -rf {} +
  install -Dm755 "$src/priv/amadeus-priv" "$src/priv/root-mode" -t "$pkgdir/usr/lib/amadeus/"
  printf '#!/usr/bin/python3\nimport sys\nsys.path.insert(0, "/usr/share/amadeus-ai")\nfrom amadeus.cli import main\nmain()\n' >"$pkgdir/usr/bin/ama"
  chmod 755 "$pkgdir/usr/bin/ama"
  sed 's|@AMA@|/usr/bin/ama|' "$src/systemd/amadeusd.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/amadeusd.service"
  # Failed services and a nearly full disk are reported to the session daemon.
  install -Dm755 "$src/priv/notice-system" -t "$pkgdir/usr/lib/amadeus/"
  for scope in user system; do
    install -Dm644 "$src/systemd/10-amadeus-notice.conf" -t "$pkgdir/usr/lib/systemd/$scope/service.d/"
    printf '[Unit]\nOnFailure=\n' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/$scope/amadeus-notice@.service.d/10-no-loop.conf"
  done
  sed 's|@NOTICE@|/usr/bin/ama event unit-failed scope=user unit=|; s|= %i|=%i|' "$src/systemd/amadeus-notice.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/amadeus-notice@.service"
  sed 's|@NOTICE@|/usr/lib/amadeus/notice-system|' "$src/systemd/amadeus-notice.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/amadeus-notice@.service"
  # The crash handler only starts the reporter; its own sandbox cannot reach a user's session.
  printf '[Service]\nExecStopPost=-+/usr/bin/systemctl start --no-block amadeus-crash-notice.service\n' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/systemd-coredump@.service.d/10-amadeus-notice.conf"
  sed 's|@NOTICE@|/usr/lib/amadeus/notice-system|' "$src/systemd/amadeus-crash-notice.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/amadeus-crash-notice.service"
  sed 's|@AMA@|/usr/bin/ama|' "$src/systemd/amadeus-space.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/amadeus-space.service"
  install -Dm644 "$src/systemd/amadeus-space.timer" -t "$pkgdir/usr/lib/systemd/user/"
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../amadeus-space.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/amadeus-space.timer"
  install -Dm644 "$src/priv/org.amadeus.rootmode.policy" -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 "$src"/../docs/*.md "$src/../README.md" -t "$pkgdir/usr/share/doc/amadeus/"
}
