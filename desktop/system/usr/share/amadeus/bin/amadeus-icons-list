#!/bin/bash

# amadeus:summary=List available icon sets

# Original is the set with nothing in it: every app shows its own icon.
{
  find ~/.config/amadeus/icons/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$AMADEUS_PATH/icons/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
  echo original
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
