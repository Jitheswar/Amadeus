#!/bin/bash

# amadeus:summary=Show current background
# amadeus:examples=amadeus theme bg current

BACKGROUND_PATH=$(readlink -f "$HOME/.local/state/amadeus/current/background" 2>/dev/null)

if [[ -n $BACKGROUND_PATH ]]; then
  basename -- "$BACKGROUND_PATH" | perl -pe 's/\.[^.\n]+$//; s/^\d+-//; s/-/ /g; s/\b(\w)/\U$1/g'
else
  echo "Unknown"
fi
