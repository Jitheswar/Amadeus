#!/usr/bin/python3
# Choose one look for the whole system: the shell, the panel, terminals, GTK applications, the lock screen and more.
"""amadeus-theme [list | current | set NAME | render NAME DIR]

A theme is one file, colors.toml. Every application's colours are rendered from it
through the templates in /usr/share/amadeus-os/themed, the way Omarchy does it, so
an application installed later is already themed. With no argument, pick from a list.

Your own themes go in ~/.config/amadeus/themes/NAME/colors.toml, and your own
templates (or replacements for shipped ones) in ~/.config/amadeus/themed.
Terminals that are already open keep their colours until a new window is opened."""
import json, os, re, shutil, subprocess, sys, tempfile, tomllib
from pathlib import Path

SHARE = Path(os.environ.get("AMADEUS_THEME_SHARE", "/usr/share/amadeus-os"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CURRENT = CONFIG / "amadeus/current"
HEX = re.compile(r"#[0-9a-fA-F]{6}")
# The shell's and the panel's names for the palette, and where each comes from.
SHELL = {"bg": "background", "surface": "surface", "raised": "raised", "line": "line", "fg": "foreground", "dim": "dark_foreground",
         "accent": "accent", "accent2": "accent2", "good": "green", "warn": "yellow", "bad": "red"}


def mix(a, b, share):
    """Colour a moved towards colour b by share (0..1)."""
    return "#" + "".join(f"{round(int(a[i:i + 2], 16) * (1 - share) + int(b[i:i + 2], 16) * share):02x}" for i in (1, 3, 5))


def themes():
    found = {}
    for root in (SHARE / "themes", CONFIG / "amadeus/themes"):
        for f in sorted(root.glob("*/colors.toml")):
            found[f.parent.name] = f
    return found


def colors(name):
    if name not in themes():
        sys.exit(f"No theme called {name}. Themes: {', '.join(themes()) or 'none installed'}")
    data = tomllib.loads(themes()[name].read_text())
    c = {k: v.lower() for k, v in data.items() if isinstance(v, str) and HEX.fullmatch(v)}
    missing = [k for k in ("background", "foreground", "accent", "red", "green", "yellow", "blue", "magenta", "cyan") if k not in c]
    if missing:
        sys.exit(f"Theme {name} is missing: {', '.join(missing)}")
    bg, fg = c["background"], c["foreground"]
    # What a theme leaves out is derived, so a short colors.toml is still a whole theme.
    for key, value in (("surface", mix(bg, fg, 0.04)), ("raised", mix(bg, fg, 0.09)), ("line", mix(bg, fg, 0.15)),
                       ("muted", mix(bg, fg, 0.35)), ("dark_foreground", mix(fg, bg, 0.4)), ("light_foreground", mix(fg, bg, 0.12)),
                       ("bright_foreground", fg), ("selection", mix(bg, fg, 0.15)), ("accent2", c.get("orange", c["accent"])),
                       ("orange", c["accent"])):
        c.setdefault(key, value)
    for base in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        c.setdefault("bright_" + base, mix(c[base], fg, 0.2))
    return c, "light" if data.get("mode") == "light" else "dark"


def render(name, out):
    c, _ = colors(name)
    values = dict(c)
    values.update({k + "_strip": v[1:] for k, v in c.items()})
    values.update({k + "_rgb": ",".join(str(int(v[i:i + 2], 16)) for i in (1, 3, 5)) for k, v in c.items()})
    templates = {}
    for root in (SHARE / "themed", CONFIG / "amadeus/themed"):
        templates.update({f.name[:-4]: f for f in sorted(root.glob("*.tpl"))})
    out.mkdir(parents=True, exist_ok=True)
    for target, template in templates.items():
        def value(match):
            if match[1] not in values:
                sys.exit(f"{template} uses {{{{ {match[1]} }}}}, which theme {name} cannot provide")
            return values[match[1]]
        (out / target).write_text(re.sub(r"\{\{\s*([a-z0-9_]+)\s*\}\}", value, template.read_text()))
    (out / "colors.json").write_text(json.dumps(c, indent=2) + "\n")


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        if path.exists():
            shutil.copymode(path, name)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def quiet(*args):
    try:
        subprocess.run(args, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def managed(path, rendered, check=None):
    """Replace the colour keys of a file Amadeus ships, keeping everything else the
    user wrote; put the old content back if the application rejects the result."""
    if not path.exists():
        return
    new = dict(line.split("=", 1) for line in rendered.splitlines() if "=" in line)
    old = path.read_text()
    lines = [f"{line.split('=', 1)[0]}={new.pop(line.split('=', 1)[0])}" if line.split("=", 1)[0] in new else line for line in old.splitlines()]
    write(path, "\n".join(lines) + "\n")
    if check and shutil.which(check[0]) and subprocess.run(check, capture_output=True).returncode:
        write(path, old)
        print(f"{path} was left as it was: {check[0]} did not accept the new colours.")


def first(path, text):
    """Start an application's configuration with the theme, unless the user has one already."""
    if not path.exists():
        write(path, text)


def apply(name):
    c, mode = colors(name)
    staging = CURRENT / "theme.new"
    shutil.rmtree(staging, ignore_errors=True)
    render(name, staging)
    theme = CURRENT / "theme"
    old = CURRENT / "theme.old"
    shutil.rmtree(old, ignore_errors=True)
    if theme.exists():
        theme.rename(old)
    staging.rename(theme)
    shutil.rmtree(old, ignore_errors=True)
    write(CURRENT / "theme.name", name + "\n")

    # The shell and the panel follow this file live; other settings in it stay.
    personal = CONFIG / "amadeus/theme.json"
    try:
        values = json.loads(personal.read_text())
    except (OSError, ValueError):
        values = {}
    values.update({key: c[source] for key, source in SHELL.items()})
    write(personal, json.dumps(values, indent=2) + "\n")

    managed(CONFIG / "foot/foot.ini", (theme / "foot.ini").read_text(), ["foot", "--check-config"])
    managed(CONFIG / "swaylock/config", (theme / "swaylock").read_text())
    here = str(theme)
    first(CONFIG / "kitty/kitty.conf", f"include {here}/kitty.conf\n")
    first(CONFIG / "alacritty/alacritty.toml", f'general.import = ["{here}/alacritty.toml"]\n')
    first(CONFIG / "ghostty/config", f"config-file = {here}/ghostty.conf\n")
    btop = CONFIG / "btop/btop.conf"
    line = f'color_theme = "{here}/btop.theme"'
    write(btop, re.sub(r"(?m)^color_theme\s*=.*$", lambda m: line, btop.read_text()) if btop.exists() else line + "\n")
    for version in ("gtk-3.0", "gtk-4.0"):
        first(CONFIG / version / "gtk.css", f'@import url("file://{here}/gtk.css");\n')

    quiet("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-" + mode)
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        quiet("hyprctl", "reload")
    for signal, program in (("USR1", "kitty"), ("USR2", "ghostty"), ("USR2", "btop")):
        quiet("pkill", "-" + signal, "-x", program)
    print(f"Theme: {name}. Open terminals keep their colours until a new window is opened.")


def current():
    try:
        return (CURRENT / "theme.name").read_text().strip()
    except OSError:
        return "amadeus"


def main():
    args = sys.argv[1:]
    if not args:
        marked = "\n".join(f"{name}  (current)\t{name}" if name == current() else f"{name}\t{name}" for name in themes())
        p = subprocess.run(["amadeus-pick", "Theme"], input=marked, capture_output=True, text=True)
        if p.returncode == 0 and "\t" in p.stdout:
            apply(p.stdout.strip().split("\t")[1])
    elif args == ["list"]:
        print("\n".join(themes()))
    elif args == ["current"]:
        print(current())
    elif len(args) == 2 and args[0] == "set":
        apply(args[1])
    elif len(args) == 3 and args[0] == "render":
        render(args[1], Path(args[2]))
    else:
        sys.exit(__doc__)


main()
