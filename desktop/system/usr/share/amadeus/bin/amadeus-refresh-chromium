#!/bin/bash

# amadeus:summary=Refresh the ~/.config/chromium-flags.conf file from the Amadeus defaults.

# Refresh the Chromium configuration
amadeus-refresh-config chromium-flags.conf

# Install/refresh the native messaging hosts used by the bundled extensions
amadeus-install-chromium-copy-url
amadeus-install-chromium-ytdlp

# Put the Snapdragon video decoding settings back. Last, so a failure here is
# the command's result.
amadeus-install-video-decode
