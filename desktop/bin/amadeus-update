#!/bin/bash
# Update the whole system: package cache, snapshot, keyrings, packages, migrations, orphans, drivers, AUR applications and tools.
#   amadeus-update            ask once, then update everything
#   amadeus-update -y         no questions: packages are confirmed, a restart is only suggested
#   amadeus-update firmware   update device firmware (BIOS, docks, drives) through fwupd
# In the try session nothing is kept after a restart, so no snapshot is taken there.
# Run as your user, not as root. Only the newest five snapshots are kept; amadeus-rollback goes back to one.
set -euo pipefail
(( EUID != 0 )) || { echo "Run amadeus-update as your user; it asks for the password when needed."; exit 1; }

if [[ ${1:-} == firmware ]]; then
  command -v fwupdmgr >/dev/null || sudo pacman -S --needed --noconfirm fwupd
  fwupdmgr refresh --force
  exec sudo fwupdmgr update
fi
yes=no; [[ ${1:-} == -y ]] && yes=yes
state=${XDG_STATE_HOME:-$HOME/.local/state}/amadeus
mkdir -p "$state"

# Everything the update prints is kept, so a failure can be read afterwards.
if [[ -z ${AMADEUS_UPDATE_LOGGED:-} ]] && command -v script >/dev/null; then
  exec env AMADEUS_UPDATE_LOGGED=1 script -qefc "$(printf '%q ' "$0" "$@")" "$state/update.log"
fi
# One update at a time, and the computer does not sleep in the middle of one.
exec {lock}>"${XDG_RUNTIME_DIR:-/tmp}/amadeus-update.lock"
flock -n "$lock" || { echo "An update is already running."; exit 1; }
if [[ -z ${AMADEUS_UPDATE_AWAKE:-} ]] && command -v systemd-inhibit >/dev/null; then
  exec env AMADEUS_UPDATE_AWAKE=1 systemd-inhibit --what=sleep:idle:handle-lid-switch \
    --who="Amadeus update" --why="Updating the system" "$0" "$@"
fi

# Packages are unpacked before old ones are removed, and a snapshot keeps the old ones too.
avail=$(df --output=avail -B1 / 2>/dev/null | tail -n1)
if [[ $avail =~ ^[0-9]+$ ]] && (( avail < 10 * 1024 ** 3 )) && [[ ${AMADEUS_UPDATE_FORCE:-} != 1 ]]; then
  echo "At least 10 GB of free space is needed to update safely; $(( avail / 1024 ** 3 )) GB is free."
  echo "Free some space, or run AMADEUS_UPDATE_FORCE=1 amadeus-update to try anyway."
  exit 1
fi
if [[ $yes == no && -t 0 ]]; then
  read -rp "Update the system now? [Y/n] " answer
  [[ ${answer,,} =~ ^(|y|yes)$ ]] || exit 0
fi

# Ask for the password once and keep it fresh, so long downloads never ask again.
sudo true
( exec {lock}>&-; while sleep 60; do kill -0 $$ 2>/dev/null && sudo -n true 2>/dev/null || exit 0; done ) </dev/null >/dev/null 2>&1 &
keepalive=$!
trap 'kill $keepalive 2>/dev/null || true' EXIT
trap 'echo; echo "The update stopped. Read the messages above (also in $state/update.log), fix the cause and run amadeus-update again." >&2' ERR

step() { printf '\n\e[32m%s\e[0m\n' "$1"; }
confirm=(); [[ $yes == yes ]] && confirm=(--noconfirm)

# Before the snapshot: the cache is inside it, so pruning afterwards frees nothing until it expires.
step "Package cache"
sudo paccache -rk2 || echo "The package cache could not be pruned; continuing." >&2

if [[ -e ${AMADEUS_TRY_MARKER:-/run/amadeus-try} ]]; then
  echo "Try session: no snapshot is taken, and everything installed or updated here lasts until you restart."
else
  step "Snapshot"
  sudo snapper -c root create --cleanup-algorithm number --description "before update $(date '+%Y-%m-%d %H:%M')"
  sudo snapper -c root cleanup number
  echo "Snapshot taken. If this update breaks something: amadeus-rollback"
fi

# The first update ranks the official mirrors once: quality first, then measured speed.
# Later updates skip it until the lists are a month old; a failed ranking keeps the old lists.
sudo amadeus-mirrors

# New signing keys first, so packages signed with them install in the same update.
step "Signing keys"
sudo pacman -Sy --needed --noconfirm archlinux-keyring cachyos-keyring

step "System packages"
sudo pacman -Su "${confirm[@]}"

# Changes to settings that come with the new packages, each run once.
step "Settings changes"
amadeus-migrate

# Packages nothing needs any more: dependencies of something since removed.
mapfile -t orphans < <(pacman -Qtdq 2>/dev/null || true)
if (( ${#orphans[@]} )); then
  step "Packages nothing needs any more"
  printf '  %s\n' "${orphans[@]}"
  sudo pacman -Rns "${confirm[@]}" "${orphans[@]}" || echo "Kept them." >&2
fi

# Drivers new to this release, or for hardware added since the last update.
if [[ -n $(amadeus-hardware missing 2>/dev/null) ]]; then
  step "Drivers for this hardware"
  amadeus-hardware setup
fi

failed=0
if ! amadeus-aur update; then
  echo "The AUR update did not finish. Retry with amadeus-aur update." >&2
  failed=1
fi
if ! amadeus-harness update; then
  echo "The harness update did not finish. Retry with amadeus-harness update." >&2
  failed=1
fi
kill "$keepalive" 2>/dev/null || true

# A new kernel replaces the running one's modules; new hardware drivers need it to restart too.
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  if [[ $yes == no && -t 0 ]]; then
    read -rp "The kernel was updated. Restart now? [y/N] " answer
    [[ ${answer,,} =~ ^(y|yes)$ ]] && systemctl reboot
  else
    echo "The kernel was updated; restart when you can."
  fi
fi
exit "$failed"
