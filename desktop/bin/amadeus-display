#!/bin/bash
# Display setup: resolution, refresh rate, scaling and text size.
#   amadeus-display                 choose a display, then its resolution or scale, from menus
#   amadeus-display text [SIZE]     show or set text size for applications (for example 110%)
# Resolution and scale are written to ~/.config/hypr/display.lua. The whole desktop
# configuration is checked first; a setting the desktop rejects is not kept.
set -euo pipefail
conf=${XDG_CONFIG_HOME:-$HOME/.config}/hypr
file=$conf/display.lua

if [[ ${1:-} == text ]]; then
  now=$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo 1.0)
  [[ -n ${2:-} ]] || { awk -v n="$now" 'BEGIN { printf "%d%%\n", n * 100 + 0.5 }'; exit 0; }
  gsettings set org.gnome.desktop.interface text-scaling-factor "$(awk -v p="${2%\%}" 'BEGIN { printf "%.2f", p / 100 }')"
  echo "Text size: ${2%\%}%"; exit 0
fi

monitors=$(hyprctl -j monitors)
name=$(python3 -c 'import json, sys; print("\n".join(m["name"] for m in json.load(sys.stdin)))' <<<"$monitors" |
  { mapfile -t o; (( ${#o[@]} == 1 )) && echo "${o[0]}" || printf '%s\n' "${o[@]}" | amadeus-pick Display; }) || exit 0
what=$(printf 'Resolution\nScale' | amadeus-pick "$name") || exit 0
if [[ $what == Resolution ]]; then
  value=$(python3 -c 'import json, sys; print("\n".join(next(m for m in json.load(sys.stdin) if m["name"] == sys.argv[1])["availableModes"]))' "$name" <<<"$monitors" |
    sed 's/Hz$//' | amadeus-pick "Resolution of $name") || exit 0
  key=mode
else
  value=$(printf '%s\n' 1 1.25 1.5 1.6 1.75 2 | amadeus-pick "Scale of $name") || exit 0
  key=scale
fi

# Keep the other setting for this display, replace the one being changed.
mkdir -p "$conf"; touch "$file"
old=$(mktemp)                       # byte for byte, so a rejected change really is no change
cat "$file" >"$old"
trap 'rm -f "$old"' EXIT
python3 - "$file" "$name" "$key" "$value" "$monitors" <<'PY'
import json, re, sys
path, name, key, value, monitors = sys.argv[1:]
text = open(path).read()
current = {m["name"]: m for m in json.loads(monitors)}
found = dict(re.findall(r'-- (\S+) (\{.*\})', text))
settings = {n: json.loads(v) for n, v in found.items()}
m = current[name]
s = settings.setdefault(name, {"mode": "%dx%d@%.2f" % (m["width"], m["height"], m["refreshRate"]), "scale": str(m["scale"])})
s[key] = value
out = ["-- Display settings, written by amadeus-display."]
for n, v in settings.items():
    out += ["-- %s %s" % (n, json.dumps(v)),
            'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = %s })' % (n, v["mode"], v["scale"])]
open(path, "w").write("\n".join(out) + "\n")
PY
if [[ -f $conf/hyprland.lua ]] && ! Hyprland --verify-config --config "$conf/hyprland.lua" 2>&1 | grep 'config ok' >/dev/null; then
  cat "$old" >"$file"
  notify-send -a Amadeus "Display setting not applied" "The desktop rejected $key $value for $name; nothing was changed."; exit 1
fi
hyprctl reload >/dev/null
notify-send -a Amadeus "$name: $key $value"
