#!/bin/bash

# amadeus:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# amadeus:args=[toggle|on|off]
# amadeus:examples=amadeus toggle fullscreen desktop | amadeus toggle fullscreen desktop off | amadeus toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if amadeus-toggle-enabled bar-off && amadeus-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: amadeus-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

amadeus-toggle-bar "$ACTION"
amadeus-hyprland-toggle window-no-gaps "$ACTION"
