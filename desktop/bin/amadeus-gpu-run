#!/bin/bash
# Run one program on the dedicated GPU:  amadeus-gpu-run blender
# NVIDIA through PRIME render offload, AMD or Intel through Mesa's DRI_PRIME.
case $(amadeus-gpu dedicated 2>/dev/null) in
  amd|intel) exec env DRI_PRIME=1 "$@" ;;
  *) exec env __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only "$@" ;;
esac
