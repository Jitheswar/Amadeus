# Qualcomm (Snapdragon) additions, composed after amadeus-base.packages and
# amadeus-aarch64.packages (amadeus-pkg-defaults aarch64-qualcomm): what every
# Snapdragon laptop runs, which install/hardware/qualcomm/ and vulkan.sh also
# install.
linux-firmware-qcom
# Copies the vendor-signed firmware (GPU zap shader, DSP images) from Windows.
qcom-firmware-extract
# Builds the UKI with the device trees systemd-stub picks one from.
systemd-ukify
# systemd's stub with header room for every device tree's section; Arch Linux
# ARM's holds about 119 trees.
systemd-stub-amadeus
# Adreno GPUs.
vulkan-freedreno
# The cameras run through libcamera, and apps reach them through this PipeWire
# backend.
pipewire-libcamera
