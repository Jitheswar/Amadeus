#!/bin/bash
# The Amadeus menu (Super+Space): Apps, Trigger, Install, Remove, Update, Setup, System, About.
# Usage: amadeus-menu [apps|trigger|install|remove|update|setup|system|about]
pick()   { amadeus-pick "$@"; }
term()   { amadeus-terminal --title "Amadeus: $1" -e bash -c "$2; echo; read -rsn1 -p 'Press any key to close.'"; }
quoted() { local out; out=$(xargs -d '\n' printf '%q ' <<<"$1"); printf '%s' "$out"; }
say()    { notify-send -a Amadeus "$@"; }

# One category of the install catalogue: pick, then install in a terminal.
catalog() {
  local chosen; chosen=$(amadeus-catalog "$1" | pick --multi --preview 'amadeus-catalog info "$1"' "Install $2") || exit 0
  [[ -n $chosen ]] && term "install" "amadeus-catalog install $(quoted "$chosen")"
}

install_menu() {
  local pkgs name url
  case $(printf '%s\n' Terminal Browser Editor AI Development Harness 'Web app' Packages AUR | pick "Install") in
    Terminal)    catalog terminal terminal ;;
    Browser)     catalog browser browser ;;
    Editor)      catalog editor editor ;;
    AI)          catalog ai "AI app" ;;
    Development) catalog development "development tool" ;;
    Harness)
      # AI coding harnesses, installed for this user through mise. The last line opens everything mise offers.
      pkgs=$( { amadeus-harness list; printf 'More tools…\tmore\n'; } | pick --multi --preview 'amadeus-harness info "$1"' "Install harness") || exit 0
      if grep -q $'\tmore$' <<<"$pkgs"; then
        pkgs=$(amadeus-harness tools | pick --multi --preview 'amadeus-harness info "$1"' "Install tool") || exit 0
      fi
      [[ -n $pkgs ]] && term "install harness" "amadeus-harness install $(quoted "$(cut -f2 <<<"$pkgs" | grep -vx more)")" ;;
    "Web app")
      name=$(pick --new "Web app name" </dev/null); (( $? == 2 )) || exit 0
      url=$(pick --new "Address of $name" </dev/null); (( $? == 2 )) || exit 0
      say "$(amadeus-webapp install "$name" "$url")" ;;
    Packages)
      pkgs=$(pacman -Slq | sort -u | pick --multi --preview 'pacman -Sii "$1"' "Install package") || exit 0
      [[ -n $pkgs ]] && term "install" "sudo pacman -S --needed -- $(quoted "$pkgs")" ;;
    AUR)
      # User-written recipes: the details pane shows who maintains each, Alt+B shows the recipe itself.
      pkgs=$(amadeus-aur list | pick --multi --preview 'amadeus-aur info "$1"' --preview2 'amadeus-aur recipe "$1"' --hint recipe "Install from AUR") || exit 0
      [[ -n $pkgs ]] && term "install from AUR" "amadeus-aur install $(quoted "$pkgs")" ;;
  esac
}

remove_menu() {
  local pkgs
  case $(printf '%s\n' Packages Harness 'Web app' | pick "Remove") in
    Packages)   # only what was installed on purpose is offered; dependencies go with it
      pkgs=$(pacman -Qqe | pick --multi --preview 'pacman -Qi "$1"' "Remove package") || exit 0
      [[ -n $pkgs ]] && term "remove" "sudo pacman -Rns -- $(quoted "$pkgs")" ;;
    Harness)
      pkgs=$(amadeus-harness installed | pick --multi --preview 'amadeus-harness info "$1"' "Remove harness or tool") || exit 0
      [[ -n $pkgs ]] && term "remove" "amadeus-harness remove $(quoted "$pkgs")" ;;
    "Web app")
      pkgs=$(amadeus-webapp list | pick --multi "Remove web app") || exit 0
      [[ -n $pkgs ]] && say "$(xargs -d '\n' amadeus-webapp remove <<<"$pkgs")" ;;
  esac
}

# Kind of file or link -> the types that decide which application opens it.
declare -A KINDS=(
  [Browser]="x-scheme-handler/https x-scheme-handler/http text/html"
  [Files]="inode/directory"
  [Images]="image/png image/jpeg image/webp image/gif"
  [Video]="video/mp4 video/x-matroska video/webm"
  [Music]="audio/mpeg audio/flac audio/ogg"
  [Documents]="application/pdf"
  [Mail]="x-scheme-handler/mailto"
)

defaults_menu() {
  local kind; kind=$(printf '%s\n' Terminal Editor Harness Browser Files Images Video Music Documents Mail | pick "Default") || exit 0
  case $kind in
    Terminal|Editor|Harness)
      local what=${kind,,} now choice
      now=$(amadeus-default "$what")
      choice=$(amadeus-default "$what" --choices | pick "Default $what${now:+ (now $now)}") || exit 0
      [[ -n $choice ]] && say "$(amadeus-default "$what" "$choice")" "Was: ${now:-not set}"
      exit 0 ;;
  esac
  local types=${KINDS[$kind]} first; [[ -n $types ]] || exit 0
  first=${types%% *}
  local -A byname=(); local f name
  for f in /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop; do
    [[ -f $f ]] && grep -qE "^MimeType=.*(^|;|=)${first//\//\\/}(;|$)" "$f" || continue
    grep -q '^NoDisplay=true' "$f" && continue
    name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    byname[${name:-$(basename "$f" .desktop)}]=$(basename "$f")
  done
  (( ${#byname[@]} )) || { say "No application for $kind is installed"; exit 0; }
  local current; current=$(xdg-mime query default "$first")
  local choice; choice=$(printf '%s\n' "${!byname[@]}" | sort | pick "$kind opens with") || exit 0
  [[ -n ${byname[$choice]:-} ]] || exit 0
  # shellcheck disable=SC2086
  xdg-mime default "${byname[$choice]}" $types
  [[ $kind == Browser ]] && xdg-settings set default-web-browser "${byname[$choice]}" 2>/dev/null
  say "$kind now opens with $choice" "Was: ${current:-not set}"
}

# Every file a user is meant to edit, found by looking: what exists is offered.
config_menu() {
  local c=${XDG_CONFIG_HOME:-$HOME/.config} f lines=""
  for f in "Desktop and shortcuts:$c/hypr/hyprland.lua" "Display:$c/hypr/display.lua" "Added by Amadeus:$c/hypr/amadeus.lua" \
           "Bar layout:$c/amadeus/bar.json" "Look and motion:$c/amadeus/theme.json" "Defaults:$c/amadeus/defaults" \
           "AI providers and permissions:$c/amadeus/config.toml" "Terminal (foot):$c/foot/foot.ini" "Lock screen:$c/swaylock/config" \
           "Idle and sleep:$c/swayidle/config" "About screen:$c/fastfetch/config.jsonc" "Default applications:$c/mimeapps.list" \
           "Shell (bash):$HOME/.bashrc" "System look, shipped (read only):/usr/share/amadeus-os/theme.json"; do
    [[ -e ${f#*:} || ${f%%:*} == "Look and motion" ]] && lines+="${f%%:*}"$'\t'"${f#*:}"$'\n'
  done
  local choice; choice=$(printf '%s' "$lines" | pick --preview 'head -c 6000 "${1##*	}" 2>/dev/null || echo "Not created yet. Choosing it starts a new file."' "Edit") || exit 0
  [[ -n $choice ]] && exec amadeus-editor "${choice##*$'\t'}"
}

trigger_menu() {
  case $(printf '%s\n' Capture | pick "Trigger") in
    Capture)
      local recording=""
      [[ -f ${XDG_RUNTIME_DIR:-/tmp}/amadeus-record.pid ]] && kill -0 "$(cat "${XDG_RUNTIME_DIR:-/tmp}/amadeus-record.pid")" 2>/dev/null && recording=1
      local options=("Screenshot"$'\t'"area")
      if [[ -n $recording ]]; then options+=("Stop recording"$'\t'"stop")
      else options+=("Record the screen, no sound"$'\t'"rec-screen" "Record with the computer's sound, no microphone"$'\t'"rec-desktop-audio"
                     "Record with the computer's sound and the microphone"$'\t'"rec-all"); fi
      local choice; choice=$(printf '%s\n' "${options[@]}" | pick "Capture") || exit 0
      sleep 0.2                      # let the menu leave the screen before it is captured
      case ${choice##*$'\t'} in
        area|screen|window) exec amadeus-screenshot "${choice##*$'\t'}" ;;
        stop) exec amadeus-record stop ;;
        rec-*) mode=${choice##*$'\t'}; exec amadeus-record "${mode#rec-}" ;;
      esac ;;
  esac
}

setup_menu() {
  case $(printf '%s\n' Display 'Text size' Defaults Config | pick "Setup") in
    Display)     exec amadeus-display ;;
    "Text size") local s; s=$(printf '%s\n' '90%' '100%' '110%' '125%' '150%' | pick "Text size (now $(amadeus-display text))") || exit 0
                 say "$(amadeus-display text "$s")" ;;
    Defaults)    defaults_menu ;;
    Config)      config_menu ;;
  esac
}

case ${1:-$(printf '%s\n' Apps Trigger Install Remove Update Setup System About | pick "Amadeus")} in
  Apps|apps)         exec amadeus-launcher ;;
  Trigger|trigger)   trigger_menu ;;
  Install|install)   install_menu ;;
  Remove|remove)     remove_menu ;;
  Update|update)
    what=$(printf 'Everything\nHarnesses and tools only' | pick "Update") || exit 0
    [[ $what == Everything ]] && term "update" "amadeus-update" || term "update" "amadeus-harness update" ;;
  Setup|setup)       setup_menu ;;
  System|system)     exec amadeus-power-menu ;;
  About|about)       amadeus-terminal --title "About" -e bash -c "fastfetch; read -rsn1" ;;
esac
