#!/bin/bash

# amadeus:summary=Remove Hex dictation
# amadeus:requires-sudo=true

set -e

systemctl --user disable --now hex.service 2>/dev/null || true
amadeus-pkg-drop hex-bin
systemctl --user daemon-reload

# Hex's settings, history, and downloaded models stay in ~/.local/share/hex.
backend_config="${XDG_CONFIG_HOME:-$HOME/.config}/amadeus/defaults/dictation"
if [[ -f $backend_config && $(< "$backend_config") == "hex" ]]; then
  rm "$backend_config"
fi

amadeus-restart-hyprctl
