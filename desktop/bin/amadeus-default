#!/bin/bash
# Your default terminal, editor and AI coding harness: show them, list the choices, or set one.
#   amadeus-default                       show all three
#   amadeus-default terminal|editor|harness           print the current one
#   amadeus-default terminal|editor|harness --choices list what is installed and can be chosen
#   amadeus-default terminal|editor|harness VALUE      set it; takes effect at once
set -euo pipefail
file=${XDG_CONFIG_HOME:-$HOME/.config}/amadeus/defaults
declare -A FALLBACK=([terminal]=foot [editor]=nano [harness]="")
EDITORS="nano nvim vim hx helix micro emacs code codium zed zeditor gnome-text-editor kate gedit"

get() { local v; v=$(sed -n "s/^${1^^}=//p" "$file" 2>/dev/null | tail -1); printf '%s\n' "${v:-${FALLBACK[$1]}}"; }
choices() {
  case $1 in
    terminal)  # anything that says it is a terminal
      grep -lsE '^Categories=.*TerminalEmulator' /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop 2>/dev/null |
        while read -r f; do basename "$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$f" | head -1)"; done | grep -vx footclient | sort -u ;;
    editor)    for e in $EDITORS; do command -v "$e" >/dev/null && echo "$e"; done ;;
    harness)   amadeus-harness installed 2>/dev/null | grep -Fxf <(grep -v '^#' /usr/share/amadeus-os/harnesses.list | cut -f1) || true ;;
  esac
}

kind=${1:-}
case $kind in
  "") for k in terminal editor harness; do printf '%-9s %s\n' "$k" "$(get "$k" | grep . || echo "(not set)")"; done ;;
  terminal|editor|harness)
    case ${2:-} in
      "") get "$kind" ;;
      --choices) choices "$kind" ;;
      *)
        choices "$kind" | grep -qxF "$2" || { echo "$2 is not an installed $kind. Choices:"; choices "$kind" | sed 's/^/  /'; exit 1; }
        mkdir -p "$(dirname "$file")"; touch "$file"
        { grep -v "^${kind^^}=" "$file" || true; echo "${kind^^}=$2"; } >"$file.new" && mv "$file.new" "$file"
        echo "Default $kind: $2" ;;
    esac ;;
  *) sed -n 2,6p "$0"; exit 1 ;;
esac
