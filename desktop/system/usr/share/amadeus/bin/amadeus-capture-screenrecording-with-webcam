#!/bin/bash

# amadeus:summary=Pick a webcam and start a screen recording with it
# amadeus:examples=amadeus capture screenrecording-with-webcam

mapfile -t devices < <(amadeus-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  amadeus-notification-send "$(amadeus-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(amadeus-menu-select "$(amadeus-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec amadeus-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
