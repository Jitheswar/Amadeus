#!/bin/bash
# The Amadeus menu (Super+Space): Apps, Install, Remove, Update, Defaults.
# Usage: amadeus-menu [apps|install|remove|update|defaults]
pick()  { fuzzel --dmenu --prompt "$1  " "${@:2}"; }
term()  { foot --title "Amadeus: $1" -e bash -c "$2; echo; read -rsn1 -p 'Press any key to close.'"; }

install_menu() {
  local pkg; pkg=$(pacman -Slq | sort -u | pick "Install" --lines 12) || exit 0
  [[ -n $pkg ]] && term "install $pkg" "sudo pacman -S --needed -- $(printf '%q' "$pkg")"
}

remove_menu() {
  # Only what was installed on purpose is offered; dependencies go with it.
  local pkg; pkg=$(pacman -Qqe | pick "Remove" --lines 12) || exit 0
  [[ -n $pkg ]] && term "remove $pkg" "sudo pacman -Rns -- $(printf '%q' "$pkg")"
}

# Kind of file or link -> the types that decide which application opens it.
declare -A KINDS=(
  [Browser]="x-scheme-handler/https x-scheme-handler/http text/html"
  [Files]="inode/directory"
  [Images]="image/png image/jpeg image/webp image/gif"
  [Video]="video/mp4 video/x-matroska video/webm"
  [Music]="audio/mpeg audio/flac audio/ogg"
  [Documents]="application/pdf"
  [Text]="text/plain"
  [Mail]="x-scheme-handler/mailto"
)

defaults_menu() {
  local kind; kind=$(printf '%s\n' Browser Files Images Video Music Documents Text Mail | pick "Default for" --lines 8) || exit 0
  local types=${KINDS[$kind]} first; [[ -n $types ]] || exit 0
  first=${types%% *}
  local -A byname=(); local f name
  for f in /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop; do
    [[ -f $f ]] && grep -qE "^MimeType=.*(^|;|=)${first//\//\\/}(;|$)" "$f" || continue
    grep -q '^NoDisplay=true' "$f" && continue
    name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    byname[${name:-$(basename "$f" .desktop)}]=$(basename "$f")
  done
  (( ${#byname[@]} )) || { notify-send -a Amadeus "No application for $kind is installed"; exit 0; }
  local current; current=$(xdg-mime query default "$first")
  local choice; choice=$(printf '%s\n' "${!byname[@]}" | sort | pick "$kind opens with" --lines 8) || exit 0
  [[ -n ${byname[$choice]:-} ]] || exit 0
  # shellcheck disable=SC2086
  xdg-mime default "${byname[$choice]}" $types
  [[ $kind == Browser ]] && xdg-settings set default-web-browser "${byname[$choice]}" 2>/dev/null
  notify-send -a Amadeus "$kind now opens with $choice" "Was: ${current:-not set}"
}

case ${1:-$(printf 'Apps\nInstall\nRemove\nUpdate\nDefaults' | pick "Amadeus" --lines 5)} in
  Apps|apps)         exec fuzzel ;;
  Install|install)   install_menu ;;
  Remove|remove)     remove_menu ;;
  Update|update)     term "update" "amadeus-update" ;;
  Defaults|defaults) defaults_menu ;;
esac
