# Maintainer: local build
pkgname=amadeus
pkgver=0.1.0
pkgrel=1
pkgdesc="AI layer for the operating system: policy-controlled agent, sandboxed generated apps"
arch=(any)
license=(MIT)
depends=(python bubblewrap quickshell hyprland git polkit snapper systemd)
optdepends=('networkmanager: network tools' 'power-profiles-daemon: power profile control' 'cuda: GPU compute in sandboxes')
options=(!debug)

package() {
  local src="$startdir/.."
  install -d "$pkgdir/usr/share/amadeus" "$pkgdir/usr/lib/amadeus" "$pkgdir/usr/bin" "$pkgdir/usr/share/doc/amadeus"
  cp -r "$src/amadeus" "$src/shell" "$src/examples" "$pkgdir/usr/share/amadeus/"
  find "$pkgdir" -name __pycache__ -type d -exec rm -rf {} +
  install -Dm755 "$src/priv/amadeus-priv" "$src/priv/root-mode" -t "$pkgdir/usr/lib/amadeus/"
  printf '#!/usr/bin/python3\nimport sys\nsys.path.insert(0, "/usr/share/amadeus")\nfrom amadeus.cli import main\nmain()\n' >"$pkgdir/usr/bin/ama"
  chmod 755 "$pkgdir/usr/bin/ama"
  sed 's|@AMA@|/usr/bin/ama|' "$src/systemd/amadeusd.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/amadeusd.service"
  install -Dm644 "$src/priv/org.amadeus.rootmode.policy" -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 "$src"/docs/*.md "$src/README.md" -t "$pkgdir/usr/share/doc/amadeus/"
}
