#!/bin/bash
# Applications from the Arch User Repository: look them up, review the recipe, build and install.
#   amadeus-aur list                names of everything in the AUR (refreshed once a day)
#   amadeus-aur info NAME           what it is, who maintains it, how popular, what it needs
#   amadeus-aur recipe NAME         the build recipe, which is what you are trusting
#   amadeus-aur install NAME...     build and install; a package the repositories already have is refused
#   amadeus-aur update              rebuild installed AUR packages that have a newer version
# AUR recipes are written by users, not by Arch. Building needs base-devel (fakeroot, debugedit).
# Run as your user; it asks for the password when needed.
set -euo pipefail
AUR=${AMADEUS_AUR:-https://aur.archlinux.org}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/amadeus-aur
mkdir -p "$cache"
(( EUID != 0 )) || { echo "Run amadeus-aur as your user; it asks for the password when needed."; exit 1; }
declare -A build_state=()
work=''

# The system repositories come first: never build a package they carry.
from_repos() { pacman -Si "$1" >/dev/null 2>&1; }

rpc() {  # NAME... -> JSON. Package names can contain +, which a raw query string
         # would read as a space, so curl builds and encodes the query.
  local args=() a
  for a in "$@"; do args+=(--data-urlencode "arg[]=$a"); done
  curl -fsS --get "$AUR/rpc/v5/info" "${args[@]}"
}

info() {
  rpc "$1" | python3 -c '
import json, sys, time
r = json.load(sys.stdin)["results"]
if not r: sys.exit("Not in the AUR.")
r = r[0]
rows = [("Name", r["Name"]), ("Version", r["Version"]), ("About", r.get("Description") or ""), ("Website", r.get("URL") or ""),
        ("Maintainer", r.get("Maintainer") or "none (orphaned)"), ("Votes", r.get("NumVotes")), ("Popularity", round(r.get("Popularity") or 0, 2)),
        ("Updated", time.strftime("%Y-%m-%d", time.gmtime(r.get("LastModified") or 0))),
        ("Out of date", "yes, flagged " + time.strftime("%Y-%m-%d", time.gmtime(r["OutOfDate"])) if r.get("OutOfDate") else "no"),
        ("Needs", "  ".join(r.get("Depends") or []) or "nothing"), ("Needs to build", "  ".join(r.get("MakeDepends") or []) or "nothing")]
for k, v in rows: print(f"{k:<15}: {v}")
print("\nThis recipe is written by a user, not by Arch. Alt+B shows it.")'
}

fetch() {
  if [[ -z $work ]]; then
    work=$(mktemp -d "$cache/build.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
  fi
  git clone -q --depth 1 "$AUR/$1.git" "$work/$1" || return 1
  [[ -f $work/$1/PKGBUILD && -f $work/$1/.SRCINFO ]] || {
    echo "  The recipe for $1 is incomplete." >&2
    return 1
  }
}

build() {  # NAME: build and install, AUR dependencies first
  local name=$1
  [[ $name =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]] || { echo "Invalid package name: $name" >&2; return 1; }
  case ${build_state[$name]:-} in
    installed) return 0 ;;
    failed) return 1 ;;
    building) echo "  Circular AUR dependency at $name." >&2; return 1 ;;
  esac
  build_state[$name]=building
  if build_recipe "$name"; then
    build_state[$name]=installed
  else
    build_state[$name]=failed
    return 1
  fi
}

build_recipe() {
  local name=$1 dep
  echo; echo "==> $name"
  if from_repos "$name"; then
    echo "  $name is in the system repositories; they come first. Install it with: sudo pacman -S $name"
    return 1
  fi
  local tool
  for tool in fakeroot debugedit; do
    command -v "$tool" >/dev/null 2>&1 || {
      echo "  $name needs $tool to build. Install the build tools with: sudo pacman -S --needed base-devel"
      return 1
    }
  done
  fetch "$name" || return 1
  for dep in $(sed -nE 's/^\s*(make|check)?depends(_x86_64)? = ([^<>=: ]+).*/\3/p' "$work/$name/.SRCINFO" | sort -u); do
    pacman -T "$dep" >/dev/null 2>&1 && continue          # already satisfied
    pacman -Si "$dep" >/dev/null 2>&1 && continue          # in the Arch repositories; installed during the build
    pacman -Ssq "^${dep//+/\\+}$" >/dev/null 2>&1 && continue
    echo "  $name needs $dep, which also comes from the AUR."
    build "$dep" || { echo "  $dep could not be installed, so $name was skipped."; return 1; }
  done
  if [[ -z ${AMADEUS_AUR_YES:-} ]]; then
    echo "  Downloads from:"
    sed -nE 's/^\s*source(_x86_64)? = (.*::)?(.*)/    \3/p' "$work/$name/.SRCINFO" | grep -E '://' || echo "    (only files inside the recipe)"
    while :; do
      read -rp "  Build and install $name? [y]es / [n]o / [v]iew the recipe: " answer
      case ${answer,,} in
        y|yes) break ;;
        v|view) ${PAGER:-less} "$work/$name/PKGBUILD" ;;
        *) echo "  Skipped $name."; return 1 ;;
      esac
    done
  fi
  (cd "$work/$name" && makepkg -sif --needed ${AMADEUS_AUR_YES:+--noconfirm}) || { echo "  $name could not be built; nothing was changed for it."; return 1; }
}

case ${1:-} in
  list)
    f=$cache/names
    if [[ ! -s $f || -n $(find "$f" -mmin +1440 2>/dev/null) ]]; then
      curl -fsS "$AUR/packages.gz" | gunzip >"$f.new" && mv "$f.new" "$f" || { [[ -s $f ]] || { echo "Could not reach the AUR." >&2; exit 1; }; }
    fi
    cat "$f" ;;
  info)    info "${2:?name needed}" ;;
  recipe)  curl -fsS --get "$AUR/cgit/aur.git/plain/PKGBUILD" --data-urlencode "h=${2:?name needed}" ;;
  install)
    shift; (( $# )) || { sed -n 3,8p "$0"; exit 1; }
    failed=0
    for n in "$@"; do build "$n" || failed=1; done
    exit $failed ;;
  update)
    mapfile -t foreign < <(pacman -Qmq | grep -vxE 'amadeus|amadeus-desktop' || true)
    (( ${#foreign[@]} )) || exit 0
    latest=$(rpc "${foreign[@]}" | python3 -c 'import json, sys
for r in json.load(sys.stdin)["results"]: print(r["Name"], r["Version"])') || { echo "Could not reach the AUR; applications from it were not checked." >&2; exit 1; }
    failed=0
    while read -r name ver; do
      [[ -n $name && $(vercmp "$ver" "$(pacman -Q "$name" | cut -d" " -f2)") -gt 0 ]] || continue
      if from_repos "$name"; then
        echo "==> $name is in the system repositories now; pacman -Syu will manage it."
        continue
      fi
      echo "==> Updating $name to $ver"
      if ! AMADEUS_AUR_YES=1 build "$name" </dev/tty; then
        echo "    Could not update $name." >&2
        failed=1
      fi
    done <<<"$latest"
    exit "$failed" ;;
  *) sed -n 2,9p "$0"; exit 1 ;;
esac
