#!/bin/bash

# amadeus:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  amadeus-brightness-keyboard-mute on
  amadeus-osd -i microphone-muted -m "$(amadeus-i18n audio.micMuted)"
else
  amadeus-brightness-keyboard-mute off
  amadeus-osd -i microphone -m "$(amadeus-i18n audio.micOn)"
fi
