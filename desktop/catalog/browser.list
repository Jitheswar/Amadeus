Chromium	pacman:chromium
Zen	pacman:zen-browser-bin aur:zen-browser-bin
Google Chrome	aur:google-chrome
Firefox	pacman:firefox
Helium	pacman:helium-browser-bin aur:helium-browser-bin
LibreWolf	pacman:librewolf aur:librewolf-bin aur:librewolf
Tor Browser	pacman:torbrowser-launcher aur:tor-browser-bin
Mullvad Browser	pacman:mullvad-browser-bin aur:mullvad-browser-bin
Waterfox	pacman:waterfox-bin aur:waterfox-bin
Vivaldi	pacman:vivaldi
