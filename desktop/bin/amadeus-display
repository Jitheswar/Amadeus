#!/bin/bash
# Display setup: resolution, refresh rate, scaling and text size.
#   amadeus-display                 choose a display, then its resolution or scale, from menus
#   amadeus-display scale [VALUE]   show or set the focused display's scale (for example 1.25)
#   amadeus-display text [9..20|reset]  show or set one text size for the shell, apps and terminals
#   amadeus-display auto            suit scale and text size to each display you have not set up yourself
# Resolution and scale are written to ~/.config/hypr/display.lua. The whole desktop
# configuration is checked first; a setting the desktop rejects is not kept.
set -euo pipefail
conf=${XDG_CONFIG_HOME:-$HOME/.config}/hypr
file=$conf/display.lua

save() {  # NAME KEY VALUE MONITORS: write one setting, check the whole configuration, keep it or go back
  local name=$1 key=$2 value=$3 monitors=$4
  mkdir -p "$conf"; touch "$file"
  old=$(mktemp)                       # byte for byte, so a rejected change really is no change
  cat "$file" >"$old"
  trap 'rm -f "$old"' EXIT
  python3 - "$file" "$name" "$key" "$value" "$monitors" <<'PY'
import json, re, sys
path, name, key, value, monitors = sys.argv[1:]
text = open(path).read()
current = {m["name"]: m for m in json.loads(monitors)}
found = dict(re.findall(r'-- (\S+) (\{.*\})', text))
settings = {n: json.loads(v) for n, v in found.items()}
m = current[name]
s = settings.setdefault(name, {"mode": "%dx%d@%.2f" % (m["width"], m["height"], m["refreshRate"]), "scale": str(m["scale"])})
s[key] = value
out = ["-- Display settings, written by amadeus-display."]
for n, v in settings.items():
    out += ["-- %s %s" % (n, json.dumps(v)),
            'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = %s })' % (n, v["mode"], v["scale"])]
open(path, "w").write("\n".join(out) + "\n")
PY
  if [[ -f $conf/hyprland.lua ]] && ! Hyprland --verify-config --config "$conf/hyprland.lua" 2>&1 | grep 'config ok' >/dev/null; then
    cat "$old" >"$file"
    notify-send -a Amadeus "Display setting not applied" "The desktop rejected $key $value for $name; nothing was changed."; exit 1
  fi
  hyprctl reload >/dev/null
  notify-send -a Amadeus "$name: $key $value"
}

if [[ ${1:-} == text ]]; then
  shift
  exec amadeus-text-size "$@"
fi

# Runs at the start of every session and does nothing once a display has a setting of
# its own, so a choice made by hand is never replaced.
if [[ ${1:-} == auto ]]; then
  monitors=$(hyprctl -j monitors)
  theme=${XDG_CONFIG_HOME:-$HOME/.config}/amadeus/theme.json
  plan=$(python3 -c '
import json, math, re, sys
monitors, display, theme = json.loads(sys.argv[1]), sys.argv[2], sys.argv[3]
try: settled = set(re.findall(r"(?m)^-- (\S+) \{", open(display).read()))
except OSError: settled = set()
try: sized = "font_size" in json.load(open(theme))
except (OSError, ValueError): sized = False
text = 14
for m in monitors:
    w, h = m["width"], m["height"]
    inches = math.hypot(m.get("physicalWidth") or 0, m.get("physicalHeight") or 0) / 25.4
    scale, rest = 1, 1
    if inches >= 9:      # smaller is a display that does not report its real size
        want = math.hypot(w, h) / inches / 125
        whole = [c for c in (1, 1.25, 1.5, 1.6, 1.75, 2, 2.5, 3) if (w / c).is_integer() and (h / c).is_integer()]
        scale = max([c for c in whole if c <= want + 0.1] or [1])
        rest = want / scale
    if m.get("focused") or len(monitors) == 1:
        text = 16 if rest >= 1.3 else 15 if rest >= 1.12 else 14
    if m["name"] not in settled and abs(m["scale"] - scale) > 0.01:
        print("scale", m["name"], scale)
if not sized and text != 14:
    print("text", text)
' "$monitors" "$file" "$theme")
  while read -r what a b; do
    case $what in
      scale) (save "$a" scale "$b" "$monitors") || true ;;
      text)  amadeus-text-size "$a" >/dev/null || true ;;
    esac
  done <<<"$plan"
  exit 0
fi

if [[ ${1:-} == scale ]]; then
  monitors=$(hyprctl -j monitors)
  name=$(python3 -c 'import json, sys; ms = json.load(sys.stdin); f = [m for m in ms if m.get("focused")] or ms; print(f[0]["name"])' <<<"$monitors")
  now=$(python3 -c 'import json, sys; ms = json.load(sys.stdin); f = [m for m in ms if m.get("focused")] or ms; print(f[0]["scale"])' <<<"$monitors")
  [[ -n ${2:-} ]] || { printf '%s\n' "$now"; exit 0; }
  value=${2}
  [[ $value =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v v="$value" 'BEGIN { exit !(v + 0 >= 0.5 && v + 0 <= 3) }' ||
    { echo "Scale must be a number from 0.5 to 3, for example 1.25." >&2; exit 1; }
  save "$name" scale "$value" "$monitors"
  exit 0
fi

monitors=$(hyprctl -j monitors)
name=$(python3 -c 'import json, sys; print("\n".join(m["name"] for m in json.load(sys.stdin)))' <<<"$monitors" |
  { mapfile -t o; (( ${#o[@]} == 1 )) && echo "${o[0]}" || printf '%s\n' "${o[@]}" | amadeus-pick Display; }) || exit 0
what=$(printf 'Resolution\nScale' | amadeus-pick "$name") || exit 0
if [[ $what == Resolution ]]; then
  value=$(python3 -c 'import json, sys; print("\n".join(next(m for m in json.load(sys.stdin) if m["name"] == sys.argv[1])["availableModes"]))' "$name" <<<"$monitors" |
    sed 's/Hz$//' | amadeus-pick "Resolution of $name") || exit 0
  key=mode
else
  value=$(printf '%s\n' 1 1.25 1.5 1.6 1.75 2 | amadeus-pick "Scale of $name") || exit 0
  key=scale
fi
save "$name" "$key" "$value" "$monitors"
