#!/bin/bash

# amadeus:summary=Install and configure Voxtype dictation
# amadeus:requires-sudo=true

set -e

voxtype_lib_path="${AMADEUS_VOXTYPE_LIB_PATH:-/usr/lib/voxtype}"

if amadeus-cmd-missing voxtype; then
  if gum confirm --affirmative "$(amadeus-i18n common.yes)" --negative "$(amadeus-i18n common.no)" "$(amadeus-i18n dictation.installVoxtype)"; then
    amadeus-pkg-add wtype voxtype-bin
  else
    exit 0
  fi
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$config_home/voxtype"
if [[ ! -e $config_home/voxtype/config.toml ]]; then
  cp "$AMADEUS_PATH/default/voxtype/config.toml" "$config_home/voxtype/"
  # A Vulkan runtime is not enough: aarch64 voxtype-bin ships no Vulkan backend.
  if amadeus-hw-vulkan && [[ -x $voxtype_lib_path/voxtype-vulkan ]]; then
    voxtype setup gpu --enable || true
  fi
fi

# Setup reuses the configured model and downloads it only when missing.
# Retry these steps even when an earlier attempt already installed the binary.
voxtype setup --download --no-post-install
voxtype setup systemd
systemctl --user enable --now voxtype.service

amadeus-dictation-use voxtype
amadeus-restart-hyprctl
amadeus-notification-send -g  "$(amadeus-i18n dictation.voxtypeReady)" "$(amadeus-i18n dictation.hint)" -t 10000
